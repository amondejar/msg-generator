<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Single source of truth for the Stratum version: the CLI, the Stratum.* packages and the
      version written into generated services (stratum.json, Directory.Packages.props) all come from here.
    -->
    <Version>0.31.0</Version>
    <Authors>Stratum</Authors>
    <PackageTags>dotnet;microservices;aspnetcore;service-defaults;msg</PackageTags>

    <!-- Only projects that opt in are packed (the Stratum.ServiceDefaults.* libraries and the CLI tool). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
