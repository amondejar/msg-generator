{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "Name": "{{service-kebab}}",
    "Version": "0.1.0"
// @stratum:if auth
  },
  "Auth": {
    "Authority": "https://your-identity-provider.example.com/realms/your-realm",
    "Audience": "{{service-kebab}}"
// @stratum:end
  }
}
