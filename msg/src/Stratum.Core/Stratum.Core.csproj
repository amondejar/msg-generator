<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Stratum.Core</RootNamespace>
  </PropertyGroup>

  <!--
    Las plantillas viven en /templates (fuera del proyecto, para que no se compilen)
    y se incrustan como recursos. Así la CLI y el futuro editor visual usan exactamente
    las mismas plantillas sin depender de rutas en disco.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\templates\**\*"
                      LogicalName="templates/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Sin plantillas la CLI compila pero no sabe generar nada: mejor que falle aquí, diciendo por qué. -->
  <Target Name="StratumCheckTemplates" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\templates\service') Or !Exists('$(MSBuildThisFileDirectory)..\..\templates\entity')"
           Text="Falta la carpeta templates del repositorio de Stratum (templates\service, templates\entity...). Vuelve a copiarla del zip de esta versión y recompila." />
  </Target>

</Project>
