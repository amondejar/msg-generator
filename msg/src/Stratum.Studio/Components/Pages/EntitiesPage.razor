@page "/entities"
@implements IDisposable
@inject StudioState State
@inject NavigationManager Nav

<PageTitle>Entidades · Stratum Studio</PageTitle>

@if (State.Current is not { } draft)
{
    <main class="content"><p class="lead">No hay ningún servicio abierto. Elige uno en <a href="services">Servicios</a>.</p></main>
}
else
{
    var entity = Selected;
    <main class="content">
        <div>
            <div class="row" style="justify-content: space-between; align-items: center">
                <h1>Entidades</h1>
                @if (!draft.IsNew && State.Plan is { Changes.Count: > 0 })
                {
                    <div class="row" style="gap: 8px">
                        <button type="button" class="btn" @onclick="State.Discard">Descartar cambios</button>
                        <a class="btn btn-primary" href="apply">Revisar y aplicar →</a>
                    </div>
                }
            </div>
            <p class="lead">Crea entidades o cambia las que ya existen: Stratum regenera sus archivos <span class="mono">.g.cs</span> y nunca toca tu código (las clases <span class="mono">partial</span> sin <span class="mono">.g</span>). Nada se escribe hasta que revisas y aplicas.</p>
        </div>

        <div class="row" role="tablist" aria-label="Entidades">
            @foreach (var e in draft.Entities)
            {
                <button type="button" role="tab" aria-selected="@(e == entity ? "true" : "false")"
                        class="card @(e == entity ? "selected" : e.IsNew ? "new" : "")" style="padding: 10px 14px"
                        @onclick="() => State.SelectedEntity = e.Name">
                    <b style="@(e.Removed ? "text-decoration: line-through" : "")">@e.Name @if (e.IsNew) { <small style="color: var(--warn)">NUEVA</small> } else if (e.Removed) { <small style="color: var(--err)">ELIMINAR</small> } else if (e.IsLegacy && !e.Convert) { <small class="hint">ANTERIOR A 0.10</small> } else if (e.Convert) { <small style="color: var(--warn)">CONVERTIR</small> }</b>
                    <small>@e.Properties.Count propiedad(es)</small>
                </button>
            }
            <button type="button" class="btn btn-dashed" @onclick="() => State.AddEntity()">+ Nueva entidad</button>
        </div>

        @if (entity is null)
        {
            <p class="lead">Este servicio aún no tiene entidades. Crea la primera: Stratum generará la persistencia, los endpoints CRUD y sus tests.</p>
        }
        else
        {
            <div class="row" style="align-items: flex-end">
                <label class="field">
                    Nombre (singular)
                    <input type="text" value="@entity.Name" disabled="@(!entity.IsNew)" style="font-size: 18px; font-weight: 600"
                           @onchange="e => Rename(entity, e.Value?.ToString())" />
                </label>
                <label class="field">
                    Plural
                    <input type="text" value="@entity.Plural" placeholder="@entity.EffectivePlural" disabled="@(!entity.IsNew)"
                           @onchange="e => { entity.Plural = e.Value?.ToString() ?? string.Empty; State.Recompute(); }" />
                </label>
                <div class="field">
                    Endpoints
                    <span class="mono" style="min-height: 42px; display: flex; align-items: center; color: var(--text-2); font-weight: 400">/api/v1/@Route(entity)</span>
                </div>
                @if (!entity.Removed)
                {
                    <button type="button" class="btn" style="color: var(--err)" @onclick="() => State.RemoveEntity(entity)">@(entity.IsNew ? "Quitar entidad" : "Eliminar entidad")</button>
                }
            </div>

            @if (entity.Removed)
            {
                <div class="msg warn" role="status">
                    <b>@entity.Name se eliminará al aplicar.</b> Stratum borra sus archivos <span class="mono">.g.cs</span> y la quita de stratum.json; la próxima migración borrará su tabla.
                    @if (State.ConsumersOf(draft, entity.Name) is { Count: > 0 } consumers)
                    {
                        <br /><span>Escuchan sus eventos: <b>@string.Join(", ", consumers)</b>. Después, quítales esas suscripciones en su <em>Mensajería</em> (aparecerán marcadas) o con <span class="mono">stratum subscribe --sync --prune</span>.</span>
                    }
                    <div class="row" style="margin-top: 10px">
                        <label class="row" style="gap: 8px"><input type="checkbox" checked="@draft.DeleteOwnFiles" @onchange="e => { draft.DeleteOwnFiles = e.Value is true; State.Recompute(); }" /> Borrar también mis archivos de esta entidad (handlers, repositorio, endpoints propios…)</label>
                        <button type="button" class="btn" @onclick="() => State.RemoveEntity(entity)">Restaurar</button>
                    </div>
                </div>
            }
            else if (entity.IsLegacy && !entity.Convert)
            {
                <div class="msg warn" role="status">
                    <b>Creada con una versión de Stratum anterior a la 0.10.</b> Su código está en archivos tuyos, así que Stratum no puede cambiar sus propiedades sin pisarlos.
                    Al convertirla, Stratum mueve propiedades, contratos y CRUD a archivos <span class="mono">.g.cs</span> y deja clases <span class="mono">partial</span> vacías para tu código.
                    Verás qué archivos se reemplazan o borran antes de aplicar; si los habías personalizado, pasa esos cambios a las clases partial.
                    <div class="row" style="margin-top: 10px">
                        <button type="button" class="btn btn-primary" @onclick="() => { entity.Convert = true; State.Recompute(); }">Convertir al formato editable</button>
                    </div>
                </div>
            }

            <section class="stack" aria-labelledby="h-props">
                <div class="row" style="justify-content: space-between; align-items: center">
                    <h2 class="section" id="h-props" style="margin: 0">Propiedades</h2>
                    @if (entity.CanEdit)
                    {
                        <button type="button" class="btn btn-dashed" @onclick="() => propertyEditor = EntityEditors.PropertyEditor.New(entity)">+ Añadir propiedad</button>
                    }
                </div>
                <div class="table">
                    <div class="tr head" style="@PropColumns"><span>Nombre</span><span>Tipo</span><span>Valor</span><span>Genera</span><span></span></div>
                    <div class="tr" style="@PropColumns"><span class="auto">Id</span><span class="auto">guid</span><span class="hint">—</span><span class="hint">UUID v7 · clave primaria</span><span class="hint">auto</span></div>
                    @foreach (var p in entity.Properties)
                    {
                        <div class="tr" style="@PropColumns">
                            <span class="stack" style="gap: 2px">
                                @if (entity.CanEdit)
                                {
                                    <button type="button" class="link-row mono" title="Editar" @onclick="() => propertyEditor = EntityEditors.PropertyEditor.For(p)">@p.Name</button>
                                }
                                else
                                {
                                    <span class="mono">@p.Name</span>
                                }
                                @if (p.IsRenamed)
                                {
                                    <small class="hint" style="color: var(--warn)">renombrada · antes @p.OriginalName</small>
                                }
                                else if (p.OriginalName is null && !entity.IsNew)
                                {
                                    <small class="hint" style="color: var(--ok)">nueva</small>
                                }
                            </span>
                            <span class="mono">@(p.References is { } t ? "→ " + t : p.Item is { } it ? $"▤ {it}[]" : p.Enum is { } en ? "# " + en : p.Type)</span>
                            <span>@(p.IsList ? "Lista" : p.Nullable ? "Opcional" : "Obligatorio")</span>
                            <span class="hint">@EntityEditors.Generates(p)</span>
                            @if (entity.CanEdit)
                            {
                                <span class="row-actions">
                                    <button type="button" class="icon-btn edit" aria-label="@($"Editar {p.Name}")" title="Editar" @onclick="() => propertyEditor = EntityEditors.PropertyEditor.For(p)">✎</button>
                                    <button type="button" class="icon-btn" aria-label="@($"Eliminar {p.Name}")" title="Eliminar" @onclick="() => { entity.Properties.Remove(p); State.Recompute(); }">×</button>
                                </span>
                            }
                            else
                            {
                                <span></span>
                            }
                        </div>
                    }
                    <div class="tr" style="@PropColumns"><span class="auto">CreatedAt · UpdatedAt</span><span class="auto">datetime</span><span class="hint">—</span><span class="hint">Auditoría automática</span><span class="hint">auto</span></div>
                </div>
                @if (entity.CanEdit && !entity.IsNew)
                {
                    <span class="hint">Para renombrar, edita la propiedad y cámbiale el nombre: la migración conserva los datos. Si la eliminas y creas otra, la columna se borra.</span>
                }
            </section>

            <section class="stack" aria-labelledby="h-events">
                <h2 class="section" id="h-events">Eventos para otros servicios</h2>
                @if (draft.BrokerNote is { } brokerNote)
                {
                    <span class="hint" style="color: var(--accent)">ℹ @brokerNote</span>
                }
                @{
                    <label class="row" style="gap: 8px">
                        <input type="checkbox" checked="@entity.PublishEvents" disabled="@(!entity.CanEdit)"
                               @onchange="e => SetPublishEvents(draft, entity, e)" />
                        Publicar <span class="mono">@(entity.Name)Created</span>, <span class="mono">@(entity.Name)Updated</span> y <span class="mono">@(entity.Name)Deleted</span> con sus datos
                    </label>
                    @if (entity.PublishEvents)
                    {
                        var service = ServiceName.ToKebab(draft.Name);
                        var name = System.Text.RegularExpressions.Regex.Replace(entity.Name, "(?<=[a-z0-9])([A-Z])", "-$1").ToLowerInvariant();
                        <span class="hint">Topics: <span class="mono">@($"{service}.{name}-created")</span>, <span class="mono">-updated</span>, <span class="mono">-deleted</span>. Se guardan en el outbox en la misma transacción que el cambio y se envían después, con reintentos.</span>
                    }
                }
            </section>

            @if (draft.Architecture == Architectures.CleanDdd)
            {
                <section class="stack" aria-labelledby="h-behavior">
                    <h2 class="section" id="h-behavior">Comportamiento · Clean + DDD</h2>
                    <div class="table">
                        <div class="tr head" style="grid-template-columns: 2fr 1.4fr 2fr"><span>Método del agregado</span><span>Modifica</span><span>Evento de dominio</span></div>
                        <div class="tr" style="grid-template-columns: 2fr 1.4fr 2fr"><span class="mono">@(entity.Name).Create(…) <small class="hint">fábrica</small></span><span class="hint">todas</span><span class="mono" style="color: #67E8F9">@(entity.Name)Created</span></div>
                        <div class="tr" style="grid-template-columns: 2fr 1.4fr 2fr"><span class="mono">Update(…)</span><span class="hint">todas</span><span class="mono" style="color: #67E8F9">@(entity.Name)Updated</span></div>
                        <div class="tr" style="grid-template-columns: 2fr 1.4fr 2fr"><span class="mono">Delete()</span><span class="hint">—</span><span class="mono" style="color: #67E8F9">@(entity.Name)Deleted</span></div>
                        @foreach (var o in entity.Operations.Where(o => !string.IsNullOrWhiteSpace(o.Name)))
                        {
                            var name = SafePascal(o.Name);
                            <div class="tr" style="grid-template-columns: 2fr 1.4fr 2fr">
                                <span class="mono">@(name)(@o.Parameters) <small class="hint">operación</small></span>
                                <span class="hint">tu regla ·
                                    @if (State.FindServiceFile($"{entity.Name}.{name}.cs") is { } ruleFile)
                                    {
                                        <OpenInEditor Path="@ruleFile" Label="@($"{entity.Name}.{name}.cs")" Compact="true" />
                                    }
                                    else
                                    {
                                        <span class="mono">@(entity.Name).@(name).cs</span>
                                    }
                                </span>
                                <span class="mono" style="color: #67E8F9">@(string.IsNullOrWhiteSpace(o.Event) ? ModelRules.DefaultEvent(entity.Name, name) : o.Event)</span>
                            </div>
                        }
                    </div>
                    <span class="hint">Las reglas de negocio van en <span class="mono">EnsureInvariants()</span> de <span class="mono">@(entity.Name).cs</span> (tu parte del agregado, Stratum la crea una vez y no la toca), y los efectos de cada evento en su handler de <span class="mono">@(draft.Name).Application/@Plural(entity)</span>.</span>
                </section>

                <section class="stack" aria-labelledby="h-operations">
                    <div class="row" style="justify-content: space-between; align-items: center">
                        <h2 class="section" id="h-operations" style="margin: 0">Operaciones del agregado</h2>
                        @if (entity.CanEdit)
                        {
                            <button type="button" class="btn btn-dashed" @onclick="() => operationEditor = new EntityEditors.OperationEditor()">+ Añadir operación</button>
                        }
                    </div>
                    <span class="hint">Acciones de negocio como <span class="mono">Confirm</span> o <span class="mono">Cancel(Reason)</span>, cada una con su comando, su evento y <span class="mono">POST /api/v1/@Route(entity)/{id}/&lt;operación&gt;</span>. La regla la escribes tú en <span class="mono">@(entity.Name).&lt;Operación&gt;.cs</span>.</span>
                    @if (entity.Operations.Count > 0)
                    {
                        <div class="table">
                            <div class="tr head" style="@OpColumns"><span>Operación</span><span>Parámetros</span><span>Evento</span><span>Publica</span><span></span></div>
                            @foreach (var o in entity.Operations)
                            {
                                <div class="tr" style="@OpColumns">
                                    @if (entity.CanEdit)
                                    {
                                        <button type="button" class="link-row mono" title="Editar" @onclick="() => operationEditor = EntityEditors.OperationEditor.For(o)">@o.Name</button>
                                    }
                                    else
                                    {
                                        <span class="mono">@o.Name</span>
                                    }
                                    <span class="mono hint">@(string.IsNullOrWhiteSpace(o.Parameters) ? "—" : o.Parameters)</span>
                                    <span class="mono" style="color: #67E8F9">@(string.IsNullOrWhiteSpace(o.Event) ? ModelRules.DefaultEvent(entity.Name, SafePascal(o.Name)) : o.Event)</span>
                                    <span class="@(o.Publish ? null : "hint")">@(o.Publish ? "Sí" : "No")</span>
                                    @if (entity.CanEdit)
                                    {
                                        <span class="row-actions">
                                            <button type="button" class="icon-btn edit" aria-label="@($"Editar {o.Name}")" title="Editar" @onclick="() => operationEditor = EntityEditors.OperationEditor.For(o)">✎</button>
                                            <button type="button" class="icon-btn" aria-label="@($"Quitar {o.Name}")" title="Quitar" @onclick="() => { entity.Operations.Remove(o); State.Recompute(); }">×</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        }

        <section class="stack" aria-labelledby="h-enums">
            <div class="row" style="justify-content: space-between; align-items: center">
                <h2 class="section" id="h-enums" style="margin: 0">Enumerados del servicio</h2>
                <button type="button" class="btn btn-dashed" @onclick="() => enumEditor = EntityEditors.EnumEditor.New()">+ Nuevo enumerado</button>
            </div>
            @if (draft.Enums.Count == 0)
            {
                <span class="hint">Listas de valores fijos, como el estado de un pedido. Se usan como tipo de una propiedad (<span class="mono"># OrderStatus</span>).</span>
            }
            else
            {
                <div class="table">
                    <div class="tr head" style="@ListColumns"><span>Nombre</span><span>Valores</span><span>Lo usan</span><span></span></div>
                    @foreach (var en in draft.Enums)
                    {
                        var usages = Usages(draft, en);
                        <div class="tr" style="@ListColumns">
                            <button type="button" class="link-row mono" title="Editar" @onclick="() => enumEditor = EntityEditors.EnumEditor.For(en)">@en.Name</button>
                            <span class="mono hint">@en.Values</span>
                            <span class="hint mono">@(usages.Count == 0 ? "—" : string.Join(", ", usages))</span>
                            <span class="row-actions">
                                <button type="button" class="icon-btn edit" aria-label="@($"Editar {en.Name}")" title="Editar" @onclick="() => enumEditor = EntityEditors.EnumEditor.For(en)">✎</button>
                                <button type="button" class="icon-btn" aria-label="@($"Quitar {en.Name}")" disabled="@(usages.Count > 0)"
                                        title="@(usages.Count > 0 ? "Cambia antes el tipo de las propiedades que lo usan" : "Quitar")"
                                        @onclick="() => { draft.Enums.Remove(en); State.Recompute(); }">×</button>
                            </span>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="stack" aria-labelledby="h-types">
            <div class="row" style="justify-content: space-between; align-items: center">
                <h2 class="section" id="h-types" style="margin: 0">Tipos de elemento (listas de objetos)</h2>
                <button type="button" class="btn btn-dashed" @onclick="() => typeEditor = EntityEditors.TypeEditor.New()">+ Nuevo tipo de elemento</button>
            </div>
            @if (draft.Types.Count == 0)
            {
                <span class="hint">Para listas cuyos elementos tienen varios campos, como las líneas de un pedido (<span class="mono">▤ OrderLine[]</span>).</span>
            }
            else
            {
                <div class="table">
                    <div class="tr head" style="@ListColumns"><span>Nombre</span><span>Propiedades</span><span>Lo usan</span><span></span></div>
                    @foreach (var type in draft.Types)
                    {
                        var usages = Usages(draft, type);
                        <div class="tr" style="@ListColumns">
                            <button type="button" class="link-row mono" title="Editar" @onclick="() => typeEditor = EntityEditors.TypeEditor.For(type)">@type.Name</button>
                            <span class="mono hint">@type.Properties</span>
                            <span class="hint mono">@(usages.Count == 0 ? "—" : string.Join(", ", usages))</span>
                            <span class="row-actions">
                                <button type="button" class="icon-btn edit" aria-label="@($"Editar {type.Name}")" title="Editar" @onclick="() => typeEditor = EntityEditors.TypeEditor.For(type)">✎</button>
                                <button type="button" class="icon-btn" aria-label="@($"Quitar {type.Name}")" disabled="@(usages.Count > 0)"
                                        title="@(usages.Count > 0 ? "Cambia antes el tipo de las propiedades que lo usan" : "Quitar")"
                                        @onclick="() => { draft.Types.Remove(type); State.Recompute(); }">×</button>
                            </span>
                        </div>
                    }
                </div>
            }
        </section>

        <ProblemList />
    </main>

    @if (entity is not null && propertyEditor is not null)
    {
        <PropertyDialog Editor="propertyEditor" Entity="entity" Draft="draft" OnSaved="Saved" OnClose="() => propertyEditor = null"
                        OnNewEnum="() => enumEditor = EntityEditors.EnumEditor.New()" OnNewType="() => typeEditor = EntityEditors.TypeEditor.New()" />
    }
    @if (entity is not null && operationEditor is not null)
    {
        <OperationDialog Editor="operationEditor" Entity="entity" Draft="draft" OnSaved="() => OperationSaved(draft, entity)" OnClose="() => operationEditor = null" />
    }
    @if (enumEditor is not null)
    {
        <EnumDialog Editor="enumEditor" Draft="draft" OnSaved="EnumSaved" OnClose="() => enumEditor = null" />
    }
    @if (typeEditor is not null)
    {
        <TypeDialog Editor="typeEditor" Draft="draft" OnSaved="TypeSaved" OnClose="() => typeEditor = null" />
    }

    <CodePanel Tabs="EntityTabs(entity)" Label="Código generado" Empty="Selecciona o crea una entidad." Root="@(draft.IsNew ? null : State.FullPath(draft.Directory))" />
}

@code {
    private const string PropColumns = "grid-template-columns: 1.6fr 1.3fr 1fr 2fr 76px";
    private const string OpColumns = "grid-template-columns: 1.2fr 2fr 1.6fr 70px 76px";
    private const string ListColumns = "grid-template-columns: 1.1fr 2.6fr 1.4fr 76px";

    // The open dialogs (at most one per kind; an enum or item type dialog can open on top of the property one).
    private EntityEditors.PropertyEditor? propertyEditor;
    private EntityEditors.OperationEditor? operationEditor;
    private EntityEditors.EnumEditor? enumEditor;
    private EntityEditors.TypeEditor? typeEditor;

    private void Saved()
    {
        propertyEditor = null;
        State.Recompute();
    }

    private void OperationSaved(ServiceDraft draft, EntityDraft entity)
    {
        if (operationEditor is { Publish: true } o)
        {
            State.EnsureBroker(draft, $"publicar {entity.Name}.{o.Name.Trim()}");
        }

        operationEditor = null;
        State.Recompute();
    }

    /// <summary>A new enumeration created from the property dialog becomes that property's type.</summary>
    private void EnumSaved(string name)
    {
        if (enumEditor is { Original: null } && propertyEditor is not null)
        {
            propertyEditor.Type = PropertyDraft.EnumPrefix + name;
        }

        enumEditor = null;
        State.Recompute();
    }

    private void TypeSaved(string name)
    {
        if (typeEditor is { Original: null } && propertyEditor is not null)
        {
            propertyEditor.Type = PropertyDraft.ItemPrefix + name;
            propertyEditor.Kind = EntityEditors.List;
        }

        typeEditor = null;
        State.Recompute();
    }

    private EntityDraft? Selected =>
        State.Current?.Entities.FirstOrDefault(e => e.Name == State.SelectedEntity) ?? State.Current?.Entities.FirstOrDefault();

    protected override void OnInitialized()
    {
        State.Initialize();
        State.Changed += OnChanged;
        OpenFromQuery();
    }

    /// <summary>"?dialog=property|property:Name|operation:Name|enum:Name|type:Name" opens that dialog (links and checks).</summary>
    private void OpenFromQuery()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (!query.TryGetValue("dialog", out var value) || State.Current is not { } draft)
        {
            return;
        }

        var parts = value.ToString().Split(':', 2);
        var name = parts.Length > 1 ? parts[1] : null;
        var entity = Selected;
        switch (parts[0])
        {
            case "property" when entity is { CanEdit: true }:
                propertyEditor = entity.Properties.FirstOrDefault(p => p.Name == name) is { } property
                    ? EntityEditors.PropertyEditor.For(property) : EntityEditors.PropertyEditor.New(entity);
                break;
            case "operation" when entity is { CanEdit: true } && draft.Architecture == Architectures.CleanDdd:
                operationEditor = entity.Operations.FirstOrDefault(o => o.Name == name) is { } operation
                    ? EntityEditors.OperationEditor.For(operation) : new EntityEditors.OperationEditor();
                break;
            case "enum":
                enumEditor = draft.Enums.FirstOrDefault(e => e.Name == name) is { } en ? EntityEditors.EnumEditor.For(en) : EntityEditors.EnumEditor.New();
                break;
            case "type":
                typeEditor = draft.Types.FirstOrDefault(t => t.Name == name) is { } type ? EntityEditors.TypeEditor.For(type) : EntityEditors.TypeEditor.New();
                break;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;

    private void Rename(EntityDraft entity, string? name)
    {
        entity.Name = name?.Trim() ?? string.Empty;
        State.SelectedEntity = entity.Name;
        State.Recompute();
    }

    private static string SafePascal(string name)
    {
        try { return ServiceName.Normalize(name); }
        catch (StratumException) { return name; }
    }

    /// <summary>Properties (of the draft) that use the enumeration.</summary>
    private static IReadOnlyList<string> Usages(ServiceDraft draft, EnumDraft en) =>
        [.. draft.Entities.Where(e => !e.Removed).SelectMany(e => e.Properties.Where(p => p.Enum is { } n && (n == en.Name.Trim() || n == en.OriginalName)).Select(p => $"{e.Name}.{p.Name}"))];

    /// <summary>Lists (of the draft) that use the item type.</summary>
    private static IReadOnlyList<string> Usages(ServiceDraft draft, TypeDraft type) =>
        [.. draft.Entities.Where(e => !e.Removed).SelectMany(e => e.Properties.Where(p => p.Item is { } n && (n == type.Name.Trim() || n == type.OriginalName)).Select(p => $"{e.Name}.{p.Name}"))];

    private void SetPublishEvents(ServiceDraft draft, EntityDraft entity, ChangeEventArgs e)
    {
        entity.PublishEvents = e.Value is true;
        if (entity.PublishEvents)
        {
            State.EnsureBroker(draft, $"publicar los eventos de {entity.Name}");
        }

        State.Recompute();
    }

    private static string Plural(EntityDraft entity)
    {
        try { return ServiceName.Normalize(entity.EffectivePlural); }
        catch (StratumException) { return entity.EffectivePlural; }
    }

    private static string Route(EntityDraft entity) => ServiceName.ToKebab(Plural(entity));

    private IReadOnlyList<CodePanel.Tab> EntityTabs(EntityDraft? entity)
    {
        if (entity is null)
        {
            return [];
        }

        var plural = Plural(entity);
        return [.. State.Preview
            .Where(f => f.Path.Contains($"/{plural}/", StringComparison.Ordinal)
                        || f.Path.Contains($"/{entity.Name}EndpointsTests.", StringComparison.Ordinal)
                        || f.Path.Contains($"/Domain/{entity.Name}Tests.", StringComparison.Ordinal))
            .OrderBy(f => Order(f.Path))
            .Select(f => new CodePanel.Tab(TabTitle(f.Path), f.Path, f.Content))];
    }

    private static int Order(string path) =>
        path.Contains(".Domain/", StringComparison.Ordinal) ? 0
        : path.Contains(".Application/", StringComparison.Ordinal) ? 1
        : path.Contains(".Infrastructure/", StringComparison.Ordinal) ? 2
        : path.StartsWith("src/", StringComparison.Ordinal) ? 3 : 4;

    private static string TabTitle(string path) => Path.GetFileName(path).Replace(".cs", string.Empty, StringComparison.Ordinal);
}
