@page "/service/build"
@implements IDisposable
@inject StudioState State
@inject BuildRunner Builds
@inject ProcessRunner Runner
@inject EditorLauncher Editors

<PageTitle>Compilar y probar · Stratum Studio</PageTitle>

@if (State.Current is not { } draft)
{
    <main class="content"><p class="lead">No hay ningún servicio abierto. Elige uno en <a href="services">Servicios</a>.</p></main>
}
else if (draft.IsNew)
{
    <main class="content">
        <h1>Compilar y probar</h1>
        <p class="lead">@draft.Name todavía no existe en el disco. <a href="apply">Aplícalo</a> y vuelve aquí.</p>
    </main>
}
else
{
    var directory = State.FullPath(draft.Directory);
    var solution = EditorLauncher.SolutionFor(State.Workspace, directory);
    <main class="content">
        <div>
            <h1>Compilar y probar</h1>
            <p class="lead">Compila @draft.Name y lanza sus tests (SQLite en memoria: no hace falta Docker). Los errores y los tests que fallan salen resumidos, con un enlace para abrirlos en tu editor.</p>
        </div>

        <section class="card stack" style="gap: 12px">
            <div class="row" style="gap: 10px; flex-wrap: wrap; align-items: center">
                <button type="button" class="btn btn-primary" disabled="@Builds.IsBusy(directory)" @onclick="() => Start(BuildRunner.Build, directory, draft.Name)"><Icon Name="build" Size="15" /> Compilar</button>
                <button type="button" class="btn btn-primary" disabled="@Builds.IsBusy(directory)" @onclick="() => Start(BuildRunner.Test, directory, draft.Name)">▶ Ejecutar tests</button>
                <span class="spacer" style="flex: 1"></span>
                <OpenInEditor Path="@(solution ?? directory)" />
            </div>
            @if (State.Plan is { Changes.Count: > 0 })
            {
                <span class="hint" style="color: var(--warn)">⚠ Hay cambios sin aplicar: se compila lo que hay en el disco. <a href="apply">Aplícalos</a> antes si quieres probarlos.</span>
            }
            <span class="hint">Editor: @Editors.Current.Name · se cambia abajo a la izquierda.@(solution is not null ? $" Solución: {Path.GetFileName(solution)}" : string.Empty)</span>
        </section>

        <BuildResults Directory="@directory" />
    </main>
}

@code {
    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        Runner.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Runner.Changed -= OnChanged;
    }

    private void Start(string kind, string directory, string name) =>
        Builds.Start(kind, directory, kind == BuildRunner.Test ? $"Tests de {name}" : $"Compilar {name}");
}
