@inherits LayoutComponentBase
@implements IDisposable
@inject StudioState State
@inject ProcessRunner Runner
@inject NavigationManager Nav
@inject EditorLauncher Editors

<div class="app">
    <aside class="sidebar" aria-label="Menú">
        <a class="brand" href="/"><Logo /> <b>Stratum</b> <small>Studio</small></a>
        <a class="ws" href="services" title="Sistema: @State.Workspace" style="text-decoration: none"><Icon Name="folder" Size="15" /><span><b>@(Path.GetFileName(State.Workspace.TrimEnd('/', '\\')))</b></span></a>

        <nav class="stack" style="gap: 2px">
            <div class="nav-group">Sistema</div>
            <NavLink class="nav" href="/" Match="NavLinkMatch.All" ActiveClass="active"><Icon Name="home" /> Resumen</NavLink>
            <NavLink class="nav" href="services" ActiveClass="active"><Icon Name="services" /> Servicios <span class="badge">@State.Services.Count</span></NavLink>
            <NavLink class="nav" href="events" ActiveClass="active"><Icon Name="events" /> Mapa de eventos</NavLink>
            <NavLink class="nav" href="run" ActiveClass="active">
                <Icon Name="run" /> Ejecutar
                @if (Runner.IsRunning(ServiceCommands.DashboardJob))
                {
                    <span class="badge live">● en marcha</span>
                }
            </NavLink>
            <NavLink class="nav" href="templates" ActiveClass="active">
                <Icon Name="templates" /> Plantillas
                @if (State.Team is not null)
                {
                    <span class="badge">equipo</span>
                }
            </NavLink>

            @if (State.Current is { } current)
            {
                <div class="nav-group">Servicio</div>
                <div class="switcher">
                    <select aria-label="Servicio abierto" value="@SelectedKey" @onchange="Switch">
                        @if (current.IsNew)
                        {
                            <option value="@NewKey">@(string.IsNullOrWhiteSpace(current.Name) ? "Servicio nuevo" : current.Name) (nuevo)</option>
                        }
                        @foreach (var service in State.Services)
                        {
                            <option value="@service.Directory">@service.Definition.Service.Name</option>
                        }
                    </select>
                </div>
                <NavLink class="nav" href="service" Match="NavLinkMatch.All" ActiveClass="active"><Icon Name="general" /> General</NavLink>
                <NavLink class="nav" href="entities" ActiveClass="active"><Icon Name="entities" /> Entidades <span class="badge">@current.Entities.Count</span></NavLink>
                <NavLink class="nav" href="service/data" ActiveClass="active"><Icon Name="data" /> Datos y migraciones</NavLink>
                <NavLink class="nav" href="service/messaging" ActiveClass="active">
                    <Icon Name="messaging" /> Mensajería
                    @if (current.Broker is not null)
                    {
                        <span class="badge">@(current.Broker switch { MessagingSettings.Kafka => "kafka", MessagingSettings.AzureServiceBus => "service bus", _ => "memoria" })</span>
                    }
                </NavLink>
                <NavLink class="nav" href="service/code" ActiveClass="active"><Icon Name="code" /> Código generado</NavLink>
                <NavLink class="nav" href="service/build" ActiveClass="active"><Icon Name="build" /> Compilar y probar</NavLink>
                <NavLink class="nav" href="apply" ActiveClass="active">
                    <Icon Name="review" /> Revisar y aplicar
                    @if (State.Plan is { Changes.Count: > 0 } plan)
                    {
                        <span class="badge warn">@plan.Changes.Count</span>
                    }
                </NavLink>
            }
        </nav>

        <div class="sidebar-foot">
            <label class="stack" style="gap: 4px; margin-bottom: 8px">
                <span>Abrir el código con</span>
                <select aria-label="Editor para abrir el código" value="@Editors.Current.Id" @onchange="e => Editors.Choose(e.Value?.ToString() ?? EditorLauncher.SystemDefault)">
                    @foreach (var editor in Editors.Available)
                    {
                        <option value="@editor.Id">@editor.Name</option>
                    }
                </select>
            </label>
            <span>Stratum @StratumInfo.Version</span>
            <span class="mono">Fuente: stratum.json de cada servicio</span>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <div class="crumbs">
                <span>Sistema</span>
                @if (State.Current is { } c)
                {
                    <span>›</span>
                    <b>@(string.IsNullOrWhiteSpace(c.Name) ? "Servicio nuevo" : c.Name)</b>
                    <span class="layer-tag">@(c.Architecture == Architectures.CleanDdd ? "Clean + DDD" : "Vertical slice")</span>
                    @if (c.IsNew)
                    {
                        <span class="layer-tag" style="color: var(--warn); border-color: #5C4410">sin crear</span>
                    }
                }
            </div>
            <div class="spacer"></div>
            @if (State.Current is not null)
            {
                @if (State.Errors.Count > 0)
                {
                    <span class="pending" style="color: var(--err)">● @State.Errors.Count problema(s)</span>
                }
                else if (State.Plan is { Changes.Count: > 0 } pending)
                {
                    <span class="pending">● @(State.Current.IsNew ? "Servicio nuevo sin crear" : $"{pending.Changes.Count} cambio(s) sin aplicar")</span>
                }
                else
                {
                    <span class="hint">Sin cambios pendientes</span>
                }
                @if (!State.Current.IsNew)
                {
                    <OpenInEditor Path="@(EditorLauncher.SolutionFor(State.Workspace, State.FullPath(State.Current.Directory)) ?? State.FullPath(State.Current.Directory))" />
                }
                <a class="btn @(State.Plan is { Changes.Count: > 0 } ? "btn-primary" : null)" href="apply">Revisar y aplicar</a>
            }
            else
            {
                <a class="btn" href="services"><Icon Name="plus" Size="16" /> Nuevo servicio</a>
            }
        </header>

        <div class="page">
            @if (State.ExternalChangePending && State.Current is { } changed)
            {
                <div class="card row" role="alert" style="margin: 16px 24px 0; border-color: var(--warn); justify-content: space-between; gap: 12px">
                    <span>El stratum.json de <b>@changed.Name</b> ha cambiado fuera del Studio (consola, asistente o editor) y aquí tienes cambios sin aplicar.</span>
                    <button type="button" class="btn" @onclick="State.ReloadCurrent">Recargar (descarta mis cambios)</button>
                </div>
            }
            @Body
        </div>
    </div>
</div>

@code {
    private const string NewKey = "::new";

    private string SelectedKey => State.Current is { IsNew: true } ? NewKey : State.Current?.Directory ?? string.Empty;

    protected override void OnInitialized()
    {
        State.Initialize();
        OpenFromQuery();
        State.Changed += OnChanged;
        State.ExternalChange += OnExternalChange;
        Runner.Changed += OnChanged;
    }

    /// <summary>"?open=folder" (links from the events designer): opens that service, unless it's already open.</summary>
    private void OpenFromQuery()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (query.TryGetValue("open", out var open) && open.ToString() is { Length: > 0 } dir
            && State.Current?.Directory != dir
            && State.Services.FirstOrDefault(s => s.Directory == dir) is { } service)
        {
            State.Open(service);
        }
    }

    private void Switch(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        if (key == NewKey || State.Services.FirstOrDefault(s => s.Directory == key) is not { } service)
        {
            return;
        }

        State.LastMessage = null;
        State.Open(service);
        Nav.NavigateTo("service");
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnExternalChange() => InvokeAsync(() =>
    {
        State.HandleExternalChange();
        StateHasChanged();
    });

    public void Dispose()
    {
        State.ExternalChange -= OnExternalChange;
        State.Changed -= OnChanged;
        Runner.Changed -= OnChanged;
    }
}
