@* A floating dialog: drag it by its title bar, Esc or "Cerrar" closes it without saving (see the script in App.razor). *@
<div class="modal-backdrop">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="@titleId" style="width: min(@(Width)px, calc(100vw - 32px))">
        <header class="modal-head" data-drag title="Arrastra para mover la ventana">
            <div class="stack" style="gap: 2px">
                <h2 id="@titleId">@Title</h2>
                @if (Subtitle is not null)
                {
                    <span class="hint">@Subtitle</span>
                }
            </div>
            <button type="button" class="icon-btn edit" aria-label="Cerrar sin guardar" data-close @onclick="OnClose">×</button>
        </header>
        <div class="modal-body stack">@ChildContent</div>
        @if (Error is not null)
        {
            <div class="msg err" role="alert" style="margin: 0 20px">@Error</div>
        }
        <footer class="modal-foot">
            <span class="hint">@Note</span>
            <button type="button" class="btn" @onclick="OnClose">Cerrar</button>
            <button type="button" class="btn btn-primary" @onclick="OnSave">@SaveLabel</button>
        </footer>
    </div>
</div>

@code {
    private readonly string titleId = "dlg-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Shown above the buttons (why it can't be saved yet).</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Note { get; set; }

    [Parameter] public string SaveLabel { get; set; } = "Guardar y cerrar";

    [Parameter] public int Width { get; set; } = 620;

    [Parameter] public EventCallback OnSave { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
}
