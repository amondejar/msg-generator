<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- stratum studio: the visual editor. Blazor Server components on top of Stratum.Core (same engine as the CLI). -->

  <PropertyGroup>
    <RootNamespace>Stratum.Studio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The events designer: one self-contained page served by the Studio (DesignerApi). -->
    <EmbeddedResource Include="Designer\designer.html" LogicalName="Stratum.Studio.Designer.designer.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stratum.Core\Stratum.Core.csproj" />
  </ItemGroup>

</Project>
