<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Stratum.Cli</RootNamespace>
    <AssemblyName>stratum</AssemblyName>

    <!-- Installable as a global .NET tool (see README). -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>stratum</ToolCommandName>
    <PackageId>Stratum.Cli</PackageId>

    <!--
      stratum studio hosts Blazor components that live in Stratum.Studio. Since .NET 10, blazor.web.js comes from the
      implicit package Microsoft.AspNetCore.App.Internal.Assets, which the SDK only adds to projects that
      contain .razor files. This host has none, so it must ask for it explicitly (otherwise: 404, no interactivity).
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <PackageOutputPath>../../artifacts</PackageOutputPath>

    <!--
      Web SDK projects run from their own folder with "dotnet run". Stratum works on the folder you call it from,
      so a relative path such as "orders" is resolved where you are, not inside src/Stratum.Cli.
    -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
    <Description>Stratum: generador de microservicios .NET con las convenciones de tu equipo.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stratum.Core\Stratum.Core.csproj" />
    <ProjectReference Include="..\Stratum.Studio\Stratum.Studio.csproj" />
  </ItemGroup>

</Project>
