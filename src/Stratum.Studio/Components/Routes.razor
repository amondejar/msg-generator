<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(StudioLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(StudioLayout)">
            <p class="lead">Página no encontrada. <a href="/">Volver al sistema</a></p>
        </LayoutView>
    </NotFound>
</Router>
