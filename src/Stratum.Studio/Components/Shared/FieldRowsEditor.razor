@* Rows of "Name : type (obligatorio / opcional / lista)": parameters of an operation, properties of an item type. *@
<div class="rows">
    @if (Rows.Count > 0)
    {
        <div class="r head" style="@Columns"><span>@L("Nombre", "Name")</span><span>@L("Tipo", "Type")</span><span>@L("Valor", "Value")</span><span></span></div>
    }
    @foreach (var row in Rows)
    {
        <div class="r" style="@Columns">
            <input type="text" @bind="row.Name" placeholder="@NamePlaceholder" aria-label="@L("Nombre", "Name")" autocomplete="off" />
            <select @bind="row.Type" aria-label="@L($"Tipo de {row.Name}", $"Type of {row.Name}")">
                @foreach (var type in EntityEditors.BasicTypes)
                {
                    <option value="@type">@type</option>
                }
                @if (Enums.Count > 0)
                {
                    <optgroup label="@L("Enumerado", "Enumeration")">
                        @foreach (var name in Enums)
                        {
                            <option value="@name"># @name</option>
                        }
                    </optgroup>
                }
                @if (Types.Count > 0)
                {
                    <optgroup label="@L("Tipo de elemento", "Item type")">
                        @foreach (var name in Types)
                        {
                            <option value="@name">▤ @name</option>
                        }
                    </optgroup>
                }
                @if (!Known(row.Type))
                {
                    <option value="@row.Type">@row.Type</option>
                }
            </select>
            <select @bind="row.Kind" aria-label="@L($"{row.Name}: obligatorio, opcional o lista", $"{row.Name}: required, optional or list")">
                <option value="@EntityEditors.One">@L("Obligatorio", "Required")</option>
                <option value="@EntityEditors.Optional">@L("Opcional", "Optional")</option>
                @if (AllowLists)
                {
                    <option value="@EntityEditors.List">@L("Lista", "List")</option>
                }
            </select>
            <button type="button" class="icon-btn" aria-label="@L($"Quitar {row.Name}", $"Remove {row.Name}")" @onclick="() => Rows.Remove(row)">×</button>
        </div>
    }
    <button type="button" class="btn btn-dashed" style="align-self: flex-start; min-height: 34px" @onclick="() => Rows.Add(new EntityEditors.FieldRow())">@(AddLabel ?? L("+ Añadir", "+ Add"))</button>
</div>

@code {
    private const string Columns = "grid-template-columns: 1.3fr 1.2fr 1fr 32px";

    [Parameter, EditorRequired] public List<EntityEditors.FieldRow> Rows { get; set; } = [];

    [Parameter] public IReadOnlyList<string> Enums { get; set; } = [];

    /// <summary>Item types offered (operations take one item or a list of them; item types don't nest).</summary>
    [Parameter] public IReadOnlyList<string> Types { get; set; } = [];

    [Parameter] public bool AllowLists { get; set; } = true;

    [Parameter] public string? AddLabel { get; set; }

    [Parameter] public string NamePlaceholder { get; set; } = "Reason";

    private bool Known(string type) => EntityEditors.BasicTypes.Contains(type) || Enums.Contains(type) || Types.Contains(type);
}
