@page "/service/messaging"
@implements IDisposable
@inject StudioState State

<PageTitle>@L("Mensajería", "Messaging") · Stratum Studio</PageTitle>

@if (State.Current is not { } draft)
{
    <main class="content"><p class="lead">@L(@<text>No hay ningún servicio abierto. Elige uno en <a href="services">Servicios</a>.</text>, @<text>No service is open. Pick one in <a href="services">Services</a>.</text>)</p></main>
}
else
{
    <main class="content">
        <div>
            <h1>@L("Mensajería", "Messaging")</h1>
            <p class="lead">@L(@<text>Eventos de integración con otros servicios: qué publica este servicio y a qué eventos de los demás reacciona. Lo ves todo junto en el <a href="events">mapa de eventos</a>.</text>, @<text>Integration events with other services: what this service publishes and which events of the others it reacts to. See it all together in the <a href="events">event map</a>.</text>)</p>
        </div>

        <section class="stack" aria-labelledby="h-messaging">
            <h2 class="section" id="h-messaging">@L("Mensajería entre servicios", "Messaging between services")</h2>
            <div class="seg" role="group" aria-label="@L("Broker de mensajería", "Messaging broker")">
                <button type="button" aria-pressed="@(draft.Broker is null ? "true" : "false")" disabled="@(!draft.CanEditFeatures)" @onclick="() => SetBroker(null)">@L("Sin mensajería", "No messaging")</button>
                <button type="button" aria-pressed="@(draft.Broker == MessagingSettings.Kafka ? "true" : "false")" disabled="@(!draft.CanEditFeatures)" @onclick="() => SetBroker(MessagingSettings.Kafka)">Kafka</button>
                <button type="button" aria-pressed="@(draft.Broker == MessagingSettings.AzureServiceBus ? "true" : "false")" disabled="@(!draft.CanEditFeatures)" @onclick="() => SetBroker(MessagingSettings.AzureServiceBus)">Azure Service Bus</button>
                <button type="button" aria-pressed="@(draft.Broker == MessagingSettings.InMemory ? "true" : "false")" disabled="@(!draft.CanEditFeatures)" @onclick="() => SetBroker(MessagingSettings.InMemory)">@L("En memoria", "In memory")</button>
            </div>
            <span class="hint">
                @if (draft.Broker == MessagingSettings.Kafka)
                {
                    <span>@L("Eventos de integración con outbox (no se pierden si Kafka cae), inbox (cada evento se procesa una vez), reintentos y dead-letter. Con Aspire, Stratum añade Kafka y Kafka UI al AppHost. Elige abajo qué entidades publican sus eventos.", "Integration events with an outbox (not lost if Kafka goes down), an inbox (each event processed once), retries and dead-letter. With Aspire, Stratum adds Kafka and Kafka UI to the AppHost. Choose below which entities publish their events.")</span>
                }
                else if (draft.Broker == MessagingSettings.AzureServiceBus)
                {
                    <span>@L("Eventos de integración con outbox, inbox, reintentos y la cola dead-letter de Service Bus. Con Aspire se usa el emulador local (sin suscripción de Azure): Stratum declara un topic por evento y una suscripción por cada servicio que lo escucha. Todos los servicios que se comunican deben usar el mismo broker.", "Integration events with an outbox, an inbox, retries and Service Bus's dead-letter queue. With Aspire the local emulator is used (no Azure subscription): Stratum declares a topic per event and a subscription per listening service. Every service that talks to another must use the same broker.")</span>
                }
                else if (draft.Broker == MessagingSettings.InMemory)
                {
                    <span>@L("Los eventos no salen de este proceso: útil para empezar o para un servicio solo. Cambia a Kafka para que lleguen a otros servicios; tus handlers no cambian.", "Events don't leave this process: useful to start or for a single service. Switch to Kafka so they reach other services; your handlers don't change.")</span>
                }
                else
                {
                    <span>@L("Actívala para que este servicio publique eventos (OrderCreated…) o reaccione a los de otros.", "Turn it on so this service publishes events (OrderCreated…) or reacts to others' events.")</span>
                }
                @if (draft.Broker is not null && draft.ProviderLocked && !draft.IsNew)
                {
                    <span> @L(@<text>Después de aplicar, crea una migración: añade las tablas <span class="mono">msg_outbox</span> y <span class="mono">msg_inbox</span>.</text>, @<text>After applying, create a migration: it adds the <span class="mono">msg_outbox</span> and <span class="mono">msg_inbox</span> tables.</text>)</span>
                }
            </span>
        </section>

        @if (draft.BrokerNote is { } brokerNote)
        {
            <span class="hint" style="color: var(--accent)">ℹ @brokerNote</span>
        }
        @{
            <section class="stack" aria-labelledby="h-publishes">
                <h2 class="section" id="h-publishes">@L("Eventos que publica", "Events it publishes")</h2>
                @if (draft.Entities.Count == 0)
                {
                    <span class="hint">@L("El servicio no tiene entidades. Cada entidad puede publicar sus eventos Created, Updated y Deleted; al marcar Publicar se activa la mensajería si hace falta.", "The service has no entities. Each entity can publish its Created, Updated and Deleted events; ticking Publish turns messaging on if needed.")</span>
                }
                else
                {
                    <div class="table">
                        @foreach (var entity in draft.Entities)
                        {
                            <div class="tr" style="grid-template-columns: 1.2fr 2.4fr auto; align-items: center">
                                <b>@entity.Name</b>
                                <span class="hint mono">
                                    @(entity.PublishEvents ? $"{entity.Name}Created · {entity.Name}Updated · {entity.Name}Deleted" : L("no publica", "doesn't publish"))
                                    @if (!entity.PublishEvents && State.ConsumersOf(draft, entity.Name) is { Count: > 0 } consumers)
                                    {
                                        <br /><span style="color: var(--warn); font-family: inherit">⚠ @string.Join(", ", consumers) @L("escucha(n) estos eventos: al aplicar dejarán de llegarles.", "listen(s) to these events: after applying they will stop receiving them.")</span>
                                    }
                                </span>
                                <label class="row" style="gap: 8px">
                                    <input type="checkbox" checked="@entity.PublishEvents" disabled="@(!entity.CanEdit)"
                                           @onchange="e => SetPublishEvents(draft, entity, e)" />
                                    @L("Publicar", "Publish")
                                </label>
                            </div>
                        }
                    </div>
                    <span class="hint">@L("Se guardan en el outbox en la misma transacción que el cambio y se envían después, con reintentos.", "They are stored in the outbox in the same transaction as the change and sent afterwards, with retries.")</span>
                }
            </section>
        }

        @{
            var available = State.AvailableEvents(draft).Where(e => !draft.Subscriptions.Any(e.Matches)).ToList();
            var problems = State.SubscriptionProblems(draft);
            <section class="stack" aria-labelledby="h-subscriptions">
                <h2 class="section" id="h-subscriptions">@L("Eventos que escucha", "Events it listens to")</h2>
                @if (draft.Subscriptions.Count == 0)
                {
                    <span class="hint">@L("Todavía no reacciona a eventos de otros servicios.", "It doesn't react to other services' events yet.")</span>
                }
                else
                {
                    <div class="table">
                        @foreach (var subscription in draft.Subscriptions.ToList())
                        {
                            var problem = problems.FirstOrDefault(p => p.Subscription == subscription);
                            <div class="tr" style="grid-template-columns: 2.2fr 1.6fr auto; align-items: center">
                                <span>
                                    <span class="mono">@subscription.Topic</span>
                                    @if (problem.Problem is { } text)
                                    {
                                        <br /><small style="color: var(--warn)">⚠ @text</small>
                                    }
                                </span>
                                <span class="hint mono">
                                    @if (State.FindServiceFile($"{subscription.EventClass}Handler.cs") is { } handlerFile)
                                    {
                                        <OpenInEditor Path="@handlerFile" Label="@($"{subscription.EventClass}Handler.cs")" Compact="true" />
                                    }
                                    else
                                    {
                                        @($"{subscription.EventClass}Handler")
                                    }
                                    @(draft.Architecture == Architectures.CleanDdd ? " · Application" : " · Api")/Events/@subscription.Service
                                </span>
                                <span class="row" style="gap: 6px">
                                    @if (problem.Current is { } latest)
                                    {
                                        <button type="button" class="btn" @onclick="() => ReplaceSubscription(subscription, latest)">@L("Actualizar contrato", "Update contract")</button>
                                    }
                                    <button type="button" class="btn" style="color: var(--err)" @onclick="() => RemoveSubscription(subscription)">@L("Quitar", "Remove")</button>
                                </span>
                            </div>
                        }
                    </div>
                }
                @if (available.Count > 0)
                {
                    <div class="row" style="gap: 8px; align-items: flex-end">
                        <label class="field" style="flex: 0 1 380px">
                            @L("Escuchar un evento de otro servicio", "Listen to an event of another service")
                            <select @bind="selectedTopic">
                                <option value="">@L("Elige un evento…", "Choose an event…")</option>
                                @foreach (var group in available.GroupBy(e => e.Service))
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var e in group)
                                        {
                                            <option value="@e.Topic">@e.EventClass (@e.Topic)</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </label>
                        <button type="button" class="btn btn-primary" disabled="@string.IsNullOrEmpty(selectedTopic)" @onclick="() => AddSubscription(available)">@L("+ Escuchar", "+ Listen")</button>
                    </div>
                    <span class="hint">@L("Stratum copia el contrato del evento y crea un handler vacío para tu lógica (tuyo: no lo vuelve a tocar). Cada evento se procesa una vez, con reintentos y dead-letter.", "Stratum copies the event's contract and creates an empty handler for your logic (yours: it never touches it again). Each event is processed once, with retries and dead-letter.")</span>
                }
                else if (draft.Subscriptions.Count == 0)
                {
                    <span class="hint">@L(@<text>Ningún otro servicio del sistema publica eventos. Actívalo en sus <em>Entidades → Eventos para otros servicios</em>.</text>, @<text>No other service of the system publishes events. Turn it on in its <em>Entities → Events for other services</em>.</text>)</span>
                }
                @if (draft.Broker == MessagingSettings.InMemory && draft.Subscriptions.Count > 0)
                {
                    <span class="hint" style="color: var(--warn)">@L("Con el broker en memoria no llegan eventos de otros servicios: usa Kafka o Azure Service Bus.", "With the in-memory broker, other services' events don't arrive: use Kafka or Azure Service Bus.")</span>
                }
            </section>
        }

        @{
            var candidates = State.ReplicaCandidates(draft);
            var replicaProblems = State.SubscriptionProblems(draft).Where(p => draft.ReplicaSubscriptions.Contains(p.Subscription)).ToList();
            <section class="stack" aria-labelledby="h-replicas">
                <h2 class="section" id="h-replicas">@L("Réplicas de otros servicios", "Replicas of other services")</h2>
                <span class="hint">@L("Una copia local de una entidad de otro servicio (los datos que elijas), al día con sus eventos Created, Updated y Deleted. Sirve para comprobar que existe o mostrar sus datos sin llamar a ese servicio. Stratum genera la tabla, el handler y la carga inicial: al arrancar con la réplica vacía copia lo que ya existía leyendo la API del publicador.", "A local copy of an entity of another service (the data you choose), kept up to date with its Created, Updated and Deleted events. Use it to check that one exists or show its data without calling that service. Stratum generates the table, the handler and the initial load: when the service starts with the replica empty, it copies what already existed from the publisher's API.")</span>
                @if (draft.Replicas.Count > 0)
                {
                    <div class="table">
                        @foreach (var replica in draft.Replicas.ToList())
                        {
                            var created = draft.ReplicaSubscriptions.FirstOrDefault(s => s.Service == replica.Service && s.Entity == replica.Entity && s.Event == Subscription.Created);
                            var copiable = created is null ? [] : Replicas.Copiable(created);
                            var problem = replicaProblems.FirstOrDefault(p => p.Subscription.Service == replica.Service && p.Subscription.Entity == replica.Entity);
                            <div class="tr" style="grid-template-columns: 1.4fr 2.6fr auto; align-items: center">
                                <span>
                                    <b>@replica.Name</b><br />
                                    <small class="hint">@replica.Entity @L("de", "of") @replica.Service · <span class="mono">replica_…</span></small>
                                    @if (problem.Problem is { } text)
                                    {
                                        <br /><small style="color: var(--warn)">⚠ @text</small>
                                    }
                                </span>
                                <span class="row" style="gap: 10px; flex-wrap: wrap">
                                    <span class="hint mono">Id</span>
                                    @foreach (var field in copiable)
                                    {
                                        <label class="row" style="gap: 4px">
                                            <input type="checkbox" checked="@replica.Properties.Any(p => p.Name == field.Name)"
                                                   @onchange="e => ToggleReplicaField(replica, field, copiable, e.Value is true)" />
                                            @field.Name
                                        </label>
                                    }
                                </span>
                                <span class="row" style="gap: 6px">
                                    @if (problem.Current is not null)
                                    {
                                        <button type="button" class="btn" @onclick="() => State.RefreshReplica(draft, replica)">@L("Actualizar contrato", "Update contract")</button>
                                    }
                                    @if (draft.Replicas.Count > 0 && State.Services.Any(s => s.Directory == draft.Directory && (s.Definition.Replicas ?? []).Any(r => r.Service == replica.Service && r.Entity == replica.Entity)))
                                    {
                                        <button type="button" class="btn" disabled="@(loading == replica.Name)" title="@L("Con el servicio arrancado (Development): copia de nuevo lo que tiene el publicador y quita lo que ya no está.", "With the service running (Development): copies again what the publisher has and removes what is no longer there.")"
                                                @onclick="() => LoadReplica(draft, replica)">@(loading == replica.Name ? L("Cargando…", "Loading…") : L("Cargar ahora", "Load now"))</button>
                                    }
                                    <button type="button" class="btn" style="color: var(--err)" @onclick="() => RemoveReplica(replica)">@L("Quitar", "Remove")</button>
                                </span>
                            </div>
                            @if (loaded.TryGetValue(replica.Name, out var outcome))
                            {
                                <div class="hint" role="status" style="@(outcome.Ok ? string.Empty : "color: var(--warn)")">@(outcome.Ok ? "✓ " : "⚠ ")@outcome.Message</div>
                            }
                        }
                    </div>
                }
                @if (candidates.Count > 0)
                {
                    var chosen = candidates.FirstOrDefault(c => $"{c.Publisher.Service.Name}.{c.Entity}" == selectedReplica);
                    <div class="row" style="gap: 8px; align-items: flex-end; flex-wrap: wrap">
                        <label class="field" style="flex: 0 1 300px">
                            @L("Copiar una entidad de otro servicio", "Copy an entity of another service")
                            <select value="@selectedReplica" @onchange="e => SelectReplica(e.Value as string, candidates)">
                                <option value="">@L("Elige una entidad…", "Choose an entity…")</option>
                                @foreach (var group in candidates.GroupBy(c => c.Publisher.Service.Name))
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var c in group)
                                        {
                                            <option value="@($"{group.Key}.{c.Entity}")">@c.Entity</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </label>
                        @if (chosen.Publisher is not null)
                        {
                            <span class="row" style="gap: 10px; flex-wrap: wrap; padding-bottom: 6px">
                                <span class="hint mono">Id</span>
                                @foreach (var field in chosen.Fields)
                                {
                                    <label class="row" style="gap: 4px">
                                        <input type="checkbox" checked="@replicaFields.Contains(field.Name)" @onchange="e => ToggleNewField(field.Name, e.Value is true)" />
                                        @field.Name
                                    </label>
                                }
                            </span>
                        }
                        <button type="button" class="btn btn-primary" disabled="@(chosen.Publisher is null)" @onclick="() => AddReplica(chosen.Publisher!, chosen.Entity, chosen.Fields)">@L("+ Crear réplica", "+ Create replica")</button>
                    </div>
                }
                else if (draft.Replicas.Count == 0)
                {
                    <span class="hint">@L("Ninguna entidad de otro servicio publica sus tres eventos (Created, Updated y Deleted): actívalos en sus Entidades.", "No entity of another service publishes its three events (Created, Updated and Deleted): turn them on in its Entities.")</span>
                }
                @if (draft.Replicas.Count > 0 && draft.ProviderLocked && !draft.IsNew)
                {
                    <span class="hint">@L("Después de aplicar, crea una migración: añade (o cambia) la tabla de la réplica.", "After applying, create a migration: it adds (or changes) the replica's table.")</span>
                }
            </section>
        }

        <ProblemList />
    </main>
}

@code {
    protected override void OnInitialized()
    {
        State.Initialize();
        State.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;
    private string selectedTopic = string.Empty;

    private string selectedReplica = string.Empty;
    private readonly HashSet<string> replicaFields = new(StringComparer.Ordinal);

    private void SelectReplica(string? value, IReadOnlyList<(ServiceDefinition Publisher, string Entity, IReadOnlyList<PropertyDefinition> Fields)> candidates)
    {
        selectedReplica = value ?? string.Empty;
        replicaFields.Clear();
        var chosen = candidates.FirstOrDefault(c => $"{c.Publisher.Service.Name}.{c.Entity}" == selectedReplica);
        foreach (var field in chosen.Fields ?? [])
        {
            replicaFields.Add(field.Name);
        }
    }

    private void ToggleNewField(string name, bool on)
    {
        if (on)
        {
            replicaFields.Add(name);
        }
        else
        {
            replicaFields.Remove(name);
        }
    }

    private void AddReplica(ServiceDefinition publisher, string entity, IReadOnlyList<PropertyDefinition> fields)
    {
        State.AddReplica(State.Current!, publisher, entity, [.. fields.Where(f => replicaFields.Contains(f.Name))]);
        selectedReplica = string.Empty;
        replicaFields.Clear();
    }

    private void ToggleReplicaField(ReplicaDefinition replica, PropertyDefinition field, IReadOnlyList<PropertyDefinition> copiable, bool on)
    {
        var list = State.Current!.Replicas;
        var names = replica.Properties.Select(p => p.Name).ToHashSet(StringComparer.Ordinal);
        if (on)
        {
            names.Add(field.Name);
        }
        else
        {
            names.Remove(field.Name);
        }

        list[list.IndexOf(replica)] = replica with { Properties = [.. copiable.Where(p => names.Contains(p.Name))] };
        State.Recompute();
    }

    private string? loading;
    private readonly Dictionary<string, TracesApi.ActionDto> loaded = new(StringComparer.Ordinal);

    private async Task LoadReplica(ServiceDraft draft, ReplicaDefinition replica)
    {
        loading = replica.Name;
        loaded.Remove(replica.Name);
        try
        {
            loaded[replica.Name] = await TracesApi.LoadReplicaAsync(State.FullPath(draft.Directory), draft.Name, replica.Service, replica.Entity, CancellationToken.None);
        }
        finally
        {
            loading = null;
        }
    }

    private void RemoveReplica(ReplicaDefinition replica)
    {
        State.Current!.Replicas.Remove(replica);
        State.Current.ReplicaSubscriptions.RemoveAll(s => s.Service == replica.Service && s.Entity == replica.Entity);
        State.Recompute();
    }

    private void AddSubscription(IReadOnlyList<Subscription> available)
    {
        if (available.FirstOrDefault(e => e.Topic == selectedTopic) is { } subscription)
        {
            State.Current!.Subscriptions.Add(subscription);
            State.EnsureBroker(State.Current, L("escuchar ", "listen to ") + subscription.EventClass);
            selectedTopic = string.Empty;
            State.Recompute();
        }
    }

    private void RemoveSubscription(Subscription subscription)
    {
        State.Current!.Subscriptions.Remove(subscription);
        State.Recompute();
    }

    private void ReplaceSubscription(Subscription old, Subscription latest)
    {
        var list = State.Current!.Subscriptions;
        list[list.IndexOf(old)] = latest;
        State.Recompute();
    }

    private void SetPublishEvents(ServiceDraft draft, EntityDraft entity, ChangeEventArgs e)
    {
        entity.PublishEvents = e.Value is true;
        if (entity.PublishEvents)
        {
            State.EnsureBroker(draft, L($"publicar los eventos de {entity.Name}", $"publish the events of {entity.Name}"));
        }

        State.Recompute();
    }

    private void SetBroker(string? broker)
    {
        State.Current!.Broker = broker;
        State.Current.BrokerNote = null;
        if (broker is null)
        {
            foreach (var entity in State.Current.Entities)
            {
                entity.PublishEvents = false;
                foreach (var operation in entity.Operations)
                {
                    operation.Publish = false;
                }
            }

            State.Current.Subscriptions.Clear();
        }

        State.Recompute();
    }

}
