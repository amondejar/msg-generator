@page "/services"
@implements IDisposable
@inject StudioState State
@inject NavigationManager Nav

<PageTitle>@L("Servicios", "Services") · Stratum Studio</PageTitle>

<main class="content">
    <div>
        <h1>@L("Servicios", "Services")</h1>
        <p class="lead">@L(@<text>Los servicios del sistema <span class="mono">@State.Workspace</span>, incluidos los de otras carpetas (<span class="mono">stratum.workspace.json</span>). Abre uno para configurarlo o crea uno nuevo donde quieras.</text>, @<text>The services of the system <span class="mono">@State.Workspace</span>, including those in other folders (<span class="mono">stratum.workspace.json</span>). Open one to configure it or create a new one wherever you want.</text>)</p>
    </div>
    @if (State.LastMessage is { } message)
    {
        <div class="msg ok" role="status">@message</div>
    }
    <PackagesBehind />
    <section class="stack" aria-labelledby="h-services">
        <h2 class="section" id="h-services">@L("En el sistema", "In the system") · @State.Services.Count</h2>
        @if (State.Services.Count == 0)
        {
            <span class="hint">@L("Todavía no hay servicios.", "No services yet.")</span>
        }
        <div class="grid" style="align-items: start">
            @foreach (var service in State.Services)
            {
                var d = service.Definition;
                <button type="button" class="card" @onclick="() => Open(service)">
                    <span class="row" style="justify-content: space-between; gap: 8px">
                        <b style="font-size: 15px">@d.Service.Name</b>
                        <span class="layer-tag">@(d.Architecture == Architectures.CleanDdd ? "Clean + DDD" : "Vertical slice")</span>
                    </span>
                    <small class="mono" title="@State.FullPath(service.Directory)">@(State.IsExternal(service) ? State.FullPath(service.Directory) : service.Directory)</small>
                    <small>
                        @(d.Persistence?.Provider ?? L("sin base de datos", "no database")) · @d.Entities.Count @L("entidad(es)", "entity(ies)")@(d.Messaging is null ? "" : $" · {d.Messaging.Broker}")
                    </small>
                    @if (State.IsExternal(service))
                    {
                        <small class="hint">@L("Fuera de la carpeta del sistema", "Outside the system folder")</small>
                    }
                </button>
            }
        </div>
    </section>

    <section class="stack" aria-labelledby="h-new">
        <h2 class="section" id="h-new">@L("Crear un servicio", "Create a service")</h2>
        <div class="card stack" style="gap: 14px">
            <div class="form-grid">
                <label class="field">
                    @L("Nombre", "Name")
                    <input type="text" placeholder="Orders" @bind="newName" @bind:event="oninput" @onkeydown="OnKey" aria-describedby="new-hint" />
                </label>
            </div>
            <div class="field">
                @L("Carpeta", "Folder")
                <SystemFolderPicker @bind-Value="newLocation" Root="@State.Workspace" />
            </div>
            <div class="row" style="justify-content: space-between">
                <span class="hint" id="new-hint">
                    @L("Se creará en", "It will be created in") <span class="mono">@NewFolder</span>@if (!WorkspaceFile.IsInside(State.Workspace, newLocation)) {<span> · @L(@<text>fuera de la carpeta del sistema: Stratum lo apunta en <span class="mono">stratum.workspace.json</span>.</text>, @<text>outside the system folder: Stratum records it in <span class="mono">stratum.workspace.json</span>.</text>)</span>}
                </span>
                <button type="button" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(newName)" @onclick="Create"><Icon Name="plus" Size="16" /> @L("Crear y configurar", "Create and configure")</button>
            </div>
        </div>
        @if (error is not null)
        {
            <div class="msg err" role="alert">@error</div>
        }
    </section>

    <section class="stack" aria-labelledby="h-import">
        <h2 class="section" id="h-import">@L("Crear un servicio desde OpenAPI", "Create a service from OpenAPI")</h2>
        <div class="card stack" style="gap: 14px">
            <div class="form-grid">
                <label class="field">
                    @L("Especificación (fichero .yaml/.json o URL)", "Specification (.yaml/.json file or URL)")
                    <input type="text" placeholder="@L("specs/orders.yaml o https://…/openapi.json", "specs/orders.yaml or https://…/openapi.json")" @bind="importSource" @bind:event="oninput" />
                </label>
                <label class="field">
                    @L("Arquitectura", "Architecture")
                    <select @bind="importArchitecture">
                        <option value="@Architectures.VerticalSlice">Vertical slice</option>
                        <option value="@Architectures.CleanDdd">@L("Clean + DDD (las acciones POST /x/{id}/acción pasan a operaciones)", "Clean + DDD (POST /x/{id}/action becomes an operation)")</option>
                    </select>
                </label>
            </div>
            <div class="row" style="justify-content: space-between">
                <span class="hint">@L(@<text>Recursos CRUD → entidades; propiedades que apuntan a otro recurso → referencias. Se crea en la carpeta elegida arriba (<span class="mono">@NewFolder</span>) y lo revisas antes de aplicar.</text>, @<text>CRUD resources → entities; properties pointing to another resource → references. It's created in the folder chosen above (<span class="mono">@NewFolder</span>) and you review it before applying.</text>)</span>
                <button type="button" class="btn" disabled="@string.IsNullOrWhiteSpace(importSource)" @onclick="Import">@L("Importar y revisar", "Import and review")</button>
            </div>
            @if (importReport is not null)
            {
                <pre class="code" style="max-height: 320px; overflow: auto; margin: 0">@importReport</pre>
                <div class="row" style="gap: 8px">
                    <a class="btn btn-primary" href="entities">@L("Revisar entidades →", "Review entities →")</a>
                    <a class="btn" href="apply">@L("Revisar y aplicar →", "Review and apply →")</a>
                </div>
            }
        </div>
    </section>

    <section class="stack" aria-labelledby="h-external">
        <h2 class="section" id="h-external">@L("Añadir un servicio de otra carpeta", "Add a service from another folder")</h2>
        <div class="card stack" style="gap: 14px">
            <div class="field">
                @L("Carpeta del servicio (la que tiene stratum.json)", "Folder of the service (the one with stratum.json)")
                <FolderPicker @bind-Value="externalPath" Label="@L("Carpeta del servicio", "Folder of the service")" />
            </div>
            <div class="row" style="justify-content: space-between">
                <span class="hint">@L(@<text>Otro disco u otro repositorio. No se mueve ni se copia: se apunta en <span class="mono">stratum.workspace.json</span>.</text>, @<text>Another drive or repository. It isn't moved or copied: it's recorded in <span class="mono">stratum.workspace.json</span>.</text>)</span>
                <button type="button" class="btn" disabled="@string.IsNullOrWhiteSpace(externalPath)" @onclick="AddExternal">@L("Añadir al sistema", "Add to the system")</button>
            </div>
        </div>
    </section>
</main>

@code {
    private string newName = string.Empty;
    private string newLocation = string.Empty;
    private string externalPath = string.Empty;
    private string? error;
    private string importSource = string.Empty;
    private string importArchitecture = Architectures.VerticalSlice;
    private string? importReport;

    private string NewFolder
    {
        get
        {
            try
            {
                var full = Path.Combine(newLocation, string.IsNullOrWhiteSpace(newName) ? "…" : ServiceName.ToKebab(ServiceName.Normalize(newName)));
                return WorkspaceFile.IsInside(State.Workspace, newLocation) ? Path.GetRelativePath(State.Workspace, full) : full;
            }
            catch (StratumException) { return "…"; }
        }
    }

    protected override void OnInitialized()
    {
        State.Initialize();
        newLocation = State.Workspace;
        externalPath = Path.GetDirectoryName(State.Workspace) ?? State.Workspace;
        State.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;

    private void Open(WorkspaceService service)
    {
        State.LastMessage = null;
        State.Open(service);
        Nav.NavigateTo("service");
    }

    private void Create()
    {
        try
        {
            error = null;
            State.LastMessage = null;
            State.StartNewService(newName, newLocation);
            Nav.NavigateTo("service");
        }
        catch (StratumException ex)
        {
            error = ex.Message;
        }
    }

    private void Import()
    {
        try
        {
            error = null;
            State.LastMessage = null;
            importReport = State.StartFromOpenApi(importSource, importArchitecture, newLocation);
        }
        catch (Exception ex) when (ex is StratumException or IOException or UnauthorizedAccessException)
        {
            importReport = null;
            error = ex.Message;
        }
    }

    private void AddExternal()
    {
        try
        {
            error = null;
            State.AddExternalService(externalPath);
            State.LastMessage = L($"✔ Servicio de {externalPath} añadido al sistema.", $"✔ Service in {externalPath} added to the system.");
        }
        catch (StratumException ex)
        {
            error = ex.Message;
        }
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newName))
        {
            Create();
        }
    }
}
