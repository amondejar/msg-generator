@page "/service/remove"
@inject StudioState State
@inject NavigationManager Nav

<PageTitle>@L("Eliminar servicio", "Delete service") · Stratum Studio</PageTitle>

@if (State.Current is not { IsNew: false } draft)
{
    <main class="content"><p class="lead">@L(@<text>No hay ningún servicio existente abierto. Elige uno en <a href="services">Servicios</a>.</text>, @<text>No existing service is open. Pick one in <a href="services">Services</a>.</text>)</p></main>
}
else
{
    <main class="content">
        <div>
            <h1>@L("Eliminar", "Delete") @draft.Name</h1>
            <p class="lead">@L("Esto es lo que se elimina con el servicio. Nada se toca hasta que confirmes escribiendo su nombre.", "This is what goes away with the service. Nothing is touched until you confirm by typing its name.")</p>
        </div>

        @if (error is not null)
        {
            <div class="msg err" role="alert">@error</div>
        }

        @if (plan is not null)
        {
            <section class="stack" aria-labelledby="h-folder">
                <h2 class="section" id="h-folder">@L("El servicio", "The service")</h2>
                <div class="card stack">
                    <label class="row" style="gap: 10px; align-items: flex-start">
                        <input type="checkbox" checked="@deleteFolder" disabled="@(!plan.IsExternal)" @onchange="e => deleteFolder = e.Value is true" />
                        <span>
                            <b>@L("Borrar la carpeta del servicio", "Delete the service folder")</b> <span class="mono">@plan.Directory</span>
                            <br /><small class="hint">@L($"{plan.FileCount} archivo(s): código, tests, migraciones, stratum.json… No se puede deshacer (salvo que esté en Git y lo hayas subido).", $"{plan.FileCount} file(s): code, tests, migrations, stratum.json… It can't be undone (unless it's in Git and you pushed it).")</small>
                            @if (!plan.IsExternal)
                            {
                                <br /><small class="hint">@L("Está dentro de la carpeta del sistema, así que hay que borrarla: si la dejas, Stratum lo seguiría encontrando.", "It's inside the system folder, so it has to be deleted: if you leave it, Stratum would keep finding it.")</small>
                            }
                            else if (!deleteFolder)
                            {
                                <br /><small class="hint">@L("Sin borrar: el servicio solo sale del sistema (stratum.workspace.json) y sus archivos se quedan donde están.", "Not deleted: the service only leaves the system (stratum.workspace.json) and its files stay where they are.")</small>
                            }
                        </span>
                    </label>
                </div>
            </section>

            <section class="stack" aria-labelledby="h-consumers">
                <h2 class="section" id="h-consumers">@L("Otros servicios que escuchan sus eventos", "Other services that listen to its events")</h2>
                @if (plan.Consumers.Count == 0)
                {
                    <span class="hint">@L("Ninguno: no hay nada que limpiar en otros servicios.", "None: there's nothing to clean up in other services.")</span>
                }
                @foreach (var consumer in plan.Consumers)
                {
                    <div class="card stack" style="gap: 6px">
                        <b>@consumer.Service <small class="hint">@L("deja de escuchar", "stops listening to") @string.Join(", ", consumer.Subscriptions.Select(s => s.EventClass))</small></b>
                        <div class="files">
                            @foreach (var change in consumer.Plan.Changes)
                            {
                                <div class="mono" style="padding: 6px 14px; border-bottom: 1px solid #1F2330; font-size: 12.5px">
                                    <span class="@(change.Kind == ChangeKind.Delete ? "k-del" : "k-regen")">@(change.Kind == ChangeKind.Delete ? "−" : "~")</span> @change.Path
                                </div>
                            }
                        </div>
                        @foreach (var warning in consumer.Plan.Warnings)
                        {
                            <div class="msg warn">@warning</div>
                        }
                    </div>
                }
            </section>

            @if (plan.AppHost is not null || plan.Notes.Count > 0)
            {
                <section class="stack" aria-labelledby="h-rest">
                    <h2 class="section" id="h-rest">@L("Además", "Also")</h2>
                    <ul class="stack" style="margin: 0; padding-left: 18px; gap: 6px">
                        @foreach (var note in plan.Notes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                </section>
            }

            <section class="stack" aria-labelledby="h-confirm">
                <h2 class="section" id="h-confirm">@L("Confirmar", "Confirm")</h2>
                <div class="card stack" style="border-color: #7F1D1D">
                    <label class="field" style="max-width: 360px">
                        <span>@L(@<text>Escribe <span class="mono" style="color: var(--text)">@draft.Name</span> para confirmar</text>, @<text>Type <span class="mono" style="color: var(--text)">@draft.Name</span> to confirm</text>)</span>
                        <input type="text" @bind="confirmation" @bind:event="oninput" autocomplete="off" />
                    </label>
                    <div class="row">
                        <button type="button" class="btn" style="background: #7F1D1D; border-color: #B91C1C; color: #FEE2E2"
                                disabled="@(confirmation.Trim() != draft.Name)" @onclick="Remove">
                            @L("Eliminar", "Delete") @draft.Name
                        </button>
                        <a class="btn" href="service">@L("Cancelar", "Cancel")</a>
                    </div>
                </div>
            </section>
        }
    </main>
}

@code {
    private ServiceRemovalPlan? plan;
    private bool deleteFolder = true;
    private string confirmation = string.Empty;
    private string? error;

    protected override void OnInitialized()
    {
        State.Initialize();
        if (State.Current is { IsNew: false } draft)
        {
            try
            {
                plan = State.PlanRemoval(draft);
            }
            catch (StratumException ex)
            {
                error = ex.Message;
            }
        }
    }

    private void Remove()
    {
        if (plan is null)
        {
            return;
        }

        try
        {
            State.RemoveService(plan, deleteFolder || !plan.IsExternal);
            Nav.NavigateTo("services");
        }
        catch (Exception ex) when (ex is StratumException or IOException or UnauthorizedAccessException)
        {
            error = L($"No se pudo completar: {ex.Message} (¿hay un proceso usando la carpeta, como el sistema en marcha o el IDE?)", $"Couldn't finish: {ex.Message} (is a process using the folder, like the running system or the IDE?)");
        }
    }
}
