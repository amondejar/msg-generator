@page "/run"
@implements IDisposable
@inject StudioState State
@inject BuildRunner Builds
@inject ProcessRunner Runner
@inject Toolchain Tools

<PageTitle>@L("Ejecutar", "Run") · Stratum Studio</PageTitle>

<main class="content">
    <div>
        <h1>@L("Ejecutar el sistema", "Run the system")</h1>
        <p class="lead">@L("Todos los servicios a la vez con .NET Aspire: sus bases de datos, Kafka o el emulador de Service Bus si los usan, el dashboard de telemetría y el service discovery.", "All the services at once with .NET Aspire: their databases, Kafka or the Service Bus emulator if they use them, the telemetry dashboard and service discovery.")</p>
    </div>
    <section class="stack" aria-labelledby="h-aspire">
        <h2 class="section" id="h-aspire">Aspire</h2>
        <div class="card stack">
            @{ var job = Runner.Get(ServiceCommands.DashboardJob); var running = job?.Status == JobStatus.Running; }
            <div class="row">
                @if (running)
                {
                    <button type="button" class="btn" style="color: var(--err)" @onclick="StopSystem">@L("■ Detener sistema", "■ Stop system")</button>
                    @if (job!.DetectedUrl is { } dashboard)
                    {
                        <a class="btn btn-primary" href="@dashboard" target="_blank" rel="noopener">@L("Abrir dashboard de Aspire ↗", "Open the Aspire dashboard ↗")</a>
                    }
                    else
                    {
                        <span class="hint">@L("Arrancando… la primera vez compila y descarga las imágenes de las bases de datos, puede tardar unos minutos.", "Starting… the first time it builds and pulls the database images, it can take a few minutes.")</span>
                    }
                }
                else
                {
                    <button type="button" class="btn btn-primary" disabled="@(State.Services.Count == 0 || dockerMissing)" @onclick="RunSystem">@L("▶ Ejecutar sistema", "▶ Run system")</button>
                    <span class="hint">@L("Genera o actualiza el AppHost y arranca todos los servicios con sus bases de datos.", "Generates or updates the AppHost and starts every service with its databases.")</span>
                }
            </div>
            @if (dockerMissing)
            {
                <div class="msg warn" role="alert">@L("Hay servicios con base de datos o broker (Kafka, emulador de Service Bus) y no se encuentra Docker. Arranca Docker Desktop (o Podman) y", "There are services with a database or broker (Kafka, Service Bus emulator) and Docker isn't found. Start Docker Desktop (or Podman) and") <button type="button" class="btn" style="min-height: 30px; padding: 0 10px" @onclick="RecheckDocker">@L("vuelve a comprobar", "check again")</button>.</div>
            }
            @if (running)
            {
                <div class="grid">
                    @foreach (var service in State.Services)
                    {
                        var port = ServiceName.DevPort(service.Definition.Service.Name);
                        <div class="card" style="padding: 10px 14px">
                            <b>@service.Definition.Service.Name</b>
                            <small class="row" style="gap: 10px">
                                @if (service.Definition.Features.OpenApi)
                                {
                                    <a href="http://localhost:@port/scalar" target="_blank" rel="noopener">Scalar ↗</a>
                                }
                                <a href="http://localhost:@port/health/ready" target="_blank" rel="noopener">Health ↗</a>
                                <span class="mono">:@port</span>
                            </small>
                        </div>
                    }
                </div>
            }
            <JobOutput Key="@ServiceCommands.DashboardJob" Lines="12" />
        </div>
        <div class="card stack">
            <p style="margin: 0">
                @L("Un AppHost que arranca todos los servicios con sus bases de datos, el dashboard de telemetría y el service discovery.", "An AppHost that starts every service with its databases, the telemetry dashboard and service discovery.")
                @if (State.ExistingAppHost is { } appHost)
                {
                    <span> @L(@<text>Ya existe <b class="mono">@appHost</b>: al regenerarlo se incorporan los servicios nuevos sin tocar tu <span class="mono">AppHost.cs</span>.</text>, @<text><b class="mono">@appHost</b> already exists: regenerating it adds the new services without touching your <span class="mono">AppHost.cs</span>.</text>)</span>
                }
            </p>
            <div class="row">
                <label class="field" style="flex: 0 1 260px">
                    @L("Nombre del sistema", "System name")
                    <input type="text" @bind="systemName" />
                </label>
                <button type="button" class="btn" style="align-self: flex-end" disabled="@(State.Services.Count == 0)" @onclick="GenerateAppHost">
                    @(State.ExistingAppHost is null ? L("Generar AppHost", "Generate AppHost") : L("Actualizar AppHost", "Update AppHost"))
                </button>
            </div>
            @if (aspire is not null)
            {
                <div class="msg ok" role="status">
                    ✔ @aspire.AppHostName @L($"con {aspire.Services.Count} servicio(s).", $"with {aspire.Services.Count} service(s).")
                    @(aspire.Created.Count + aspire.Updated.Count == 0 ? L("Ya estaba al día.", "It was already up to date.") : L($"{aspire.Created.Count} archivo(s) nuevos, {aspire.Updated.Count} actualizados.", $"{aspire.Created.Count} new file(s), {aspire.Updated.Count} updated."))
                    @L(@<text>Arráncalo con <span class="mono">aspire run</span> (necesita Docker o Podman).</text>, @<text>Start it with <span class="mono">aspire run</span> (needs Docker or Podman).</text>)
                </div>
            }
        </div>
    </section>

    <section class="stack" aria-labelledby="h-deploy">
        <h2 class="section" id="h-deploy">@L("Despliegue", "Deployment")</h2>
        <span class="hint">@L("Opcional. Elige dónde puede desplegarse el sistema: Stratum prepara el AppHost para que aspire deploy lo lleve allí (las mismas bases de datos, broker y servicios que en local). Puedes marcar los dos.", "Optional. Choose where the system can be deployed: Stratum prepares the AppHost so that aspire deploy takes it there (the same databases, broker and services as locally). You can tick both.")</span>
        @{ var targets = State.DeployTargets; var all = State.Services.ToList(); var aspireServices = all.Select(s => new AspireService(s.Directory, s.Definition)).ToList(); }
        <div class="grid">
            @foreach (var (target, title, description) in new[]
            {
                (AspireGenerator.DeployDocker, "Docker Compose", L("En cualquier servidor o VM con Docker: un docker-compose.yaml con los servicios, sus bases de datos y Kafka.", "On any server or VM with Docker: a docker-compose.yaml with the services, their databases and Kafka.")),
                (AspireGenerator.DeployAzure, "Azure Container Apps", L("En tu suscripción de Azure: Container Apps, Azure Database for PostgreSQL o Azure SQL, y Service Bus o Kafka.", "In your Azure subscription: Container Apps, Azure Database for PostgreSQL or Azure SQL, and Service Bus or Kafka.")),
            })
            {
                var on = targets.Contains(target);
                var problem = on ? null : AspireGenerator.DeployProblem(target, aspireServices);
                <div class="card stack" style="gap: 8px">
                    <label class="row" style="gap: 8px; align-items: center">
                        <input type="checkbox" checked="@on" disabled="@(all.Count == 0 || problem is not null)" @onchange="e => SetDeploy(target, e.Value is true)" />
                        <b>@title</b>
                    </label>
                    <span class="hint">@description</span>
                    @if (problem is not null)
                    {
                        <span class="hint" style="color: var(--warn)">⚠ @problem</span>
                    }
                    @if (on)
                    {
                        <pre class="mono" style="margin: 0; white-space: pre-wrap">@DeployCommands(target, targets.Count > 1)</pre>
                    }
                </div>
            }
        </div>
    </section>

    <section class="stack" aria-labelledby="h-starts">
        <h2 class="section" id="h-starts">@L("Qué arranca", "What starts")</h2>
        @if (State.Services.Count == 0)
        {
            <span class="hint">@L("Todavía no hay servicios.", "No services yet.")</span>
        }
        else
        {
            var defs = State.Services.Select(x => x.Definition).ToList();
            <div class="table">
                <div class="tr head" style="grid-template-columns: 1.2fr 1fr 1.2fr 1.6fr"><span>@L("Servicio", "Service")</span><span>@L("Base de datos", "Database")</span><span>@L("Mensajería", "Messaging")</span><span>@L("En local", "Locally")</span></div>
                @foreach (var d in defs.OrderBy(d => d.Service.Name, StringComparer.Ordinal))
                {
                    <div class="tr" style="grid-template-columns: 1.2fr 1fr 1.2fr 1.6fr">
                        <b>@d.Service.Name</b>
                        <span class="hint">@(d.Persistence?.Provider is { } provider ? L($"{provider} (contenedor)", $"{provider} (container)") : "—")</span>
                        <span class="hint">@(d.Messaging?.Broker switch { MessagingSettings.AzureServiceBus => "Service Bus", null => "—", var b => b })</span>
                        <span class="hint mono">http://localhost:@ServiceName.DevPort(d.Service.Name)@(d.Features.IsEnabled("openApi") ? "/scalar" : "/api/v1/ping")</span>
                    </div>
                }
            </div>
            <span class="hint">
                @L("Además: el dashboard de Aspire (logs, trazas y métricas de todo)", "Also: the Aspire dashboard (logs, traces and metrics of everything)")@(defs.Any(d => d.Messaging?.Broker == MessagingSettings.Kafka) ? L(", Kafka con Kafka UI", ", Kafka with Kafka UI") : string.Empty)@(defs.Any(d => d.Messaging?.Broker == MessagingSettings.AzureServiceBus) ? L(", el emulador de Service Bus con sus topics y suscripciones", ", the Service Bus emulator with its topics and subscriptions") : string.Empty).
                @L("Las migraciones de cada servicio se aplican al arrancar.", "Each service's migrations are applied on startup.")
            </span>
            @if (defs.Any(d => d.Messaging is not null))
            {
                <div class="row" style="gap: 10px; align-items: center">
                    <a class="btn" href="/traces" target="stratum-traces" style="text-decoration: none"
                       onclick="window.open(this.href, 'stratum-traces', 'popup,width=1440,height=900'); return false;">@L("Trazas de eventos", "Event traces")</a>
                    <span class="hint">@L("Con los servicios arrancados, sigue cada evento del outbox al broker y a cada servicio que lo escucha.", "With the services running, follow each event from the outbox to the broker and to every service that listens to it.")</span>
                </div>
            }
        }
    </section>

    <section class="stack" aria-labelledby="h-system-code">
        <h2 class="section" id="h-system-code">@L("Código de todo el sistema", "Code of the whole system")</h2>
        <PackagesBehind />
        @if (EditorLauncher.SystemSolution(State.Workspace) is { } systemSolution)
        {
            <div class="row" style="gap: 10px; flex-wrap: wrap; align-items: center">
                <OpenInEditor Path="@systemSolution" Label="@L($"Abrir {Path.GetFileName(systemSolution)}", $"Open {Path.GetFileName(systemSolution)}")" />
                <button type="button" class="btn" disabled="@Builds.IsBusy(State.Workspace)" @onclick="() => BuildSystem(BuildRunner.Build, systemSolution)"><Icon Name="build" Size="15" /> @L("Compilar todo", "Build all")</button>
                <button type="button" class="btn" disabled="@Builds.IsBusy(State.Workspace)" @onclick="() => BuildSystem(BuildRunner.Test, systemSolution)">@L("▶ Tests de todos", "▶ Test all")</button>
            </div>
            <span class="hint">@L("Una solución con el AppHost y todos los servicios: ábrela en tu editor para trabajar con todo a la vez.", "A solution with the AppHost and every service: open it in your editor to work with everything at once.")</span>
            <BuildResults Directory="@State.Workspace" />
        }
        else
        {
            <span class="hint">@L(@<text>Genera el AppHost (arriba): crea una solución con todos los servicios para abrirlos juntos en tu editor y compilarlos o probarlos de una vez. Mientras, cada servicio tiene su <b>Compilar y probar</b>.</text>, @<text>Generate the AppHost (above): it creates a solution with every service to open them together in your editor and build or test them at once. Meanwhile, each service has its own <b>Build and test</b>.</text>)</span>
        }
    </section>

    <section class="stack" aria-labelledby="h-ai">
        <h2 class="section" id="h-ai">@L("Asistentes de IA", "AI assistants")</h2>
        <span class="hint">@L(@<text>Conecta Claude, Copilot o Cursor con Stratum (<span class="mono">stratum mcp</span>): podrán ver el sistema y proponer cambios (entidades, eventos, migraciones…) que tú apruebas antes de aplicarlos. Cada servicio trae además un <span class="mono">AGENTS.md</span> con sus convenciones.</text>, @<text>Connect Claude, Copilot or Cursor with Stratum (<span class="mono">stratum mcp</span>): they can see the system and propose changes (entities, events, migrations…) that you approve before they are applied. Each service also has an <span class="mono">AGENTS.md</span> with its conventions.</text>)</span>
        <pre class="code" style="margin: 0; white-space: pre-wrap">@McpClientConfig.Text(State.Workspace)</pre>
    </section>
    @if (error is not null)
    {
        <div class="msg err" role="alert">@error</div>
    }
</main>

@code {
    private void BuildSystem(string kind, string solution) =>
        Builds.Start(kind, State.Workspace, kind == BuildRunner.Test ? L("Tests del sistema", "System tests") : L("Compilar el sistema", "Build the system"), solution);

    private string? error;
    private string systemName = string.Empty;
    private AspireResult? aspire;
    private bool dockerMissing;

    protected override async Task OnInitializedAsync()
    {
        State.Initialize();
        systemName = AspireGenerator.DefaultSystemName(State.Workspace);   // the existing AppHost, if there is one
        Runner.Changed += OnChanged;
        await Task.CompletedTask;
    }

    // "docker info" can take seconds (or hang while Docker starts): checked after the first render, never while
    // prerendering, so the page answers at once and the warning appears when the check finishes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckDockerAsync();
            StateHasChanged();
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Runner.Changed -= OnChanged;

    private async Task CheckDockerAsync()
    {
        var needsDocker = State.Services.Any(s => s.Definition.Persistence is not null || s.Definition.Messaging?.Broker is MessagingSettings.Kafka or MessagingSettings.AzureServiceBus);
        dockerMissing = needsDocker && !await Tools.HasDockerAsync();
    }

    private async Task RecheckDocker()
    {
        Tools.Reset();
        await CheckDockerAsync();
    }

    private void RunSystem()
    {
        try
        {
            error = null;
            aspire = State.GenerateAppHost(systemName);   // always up to date with the services on disk
            var project = Path.Combine(State.Workspace, aspire.AppHostName, $"{aspire.AppHostName}.csproj");
            Runner.Start(ServiceCommands.DashboardJob, L("Sistema (Aspire)", "System (Aspire)"), State.Workspace, "dotnet",
                ["run", "--project", project], ServiceCommands.DashboardUrl());
        }
        catch (Exception ex) when (ex is StratumException or InvalidOperationException)
        {
            error = ex.Message;
        }
    }

    private void StopSystem() => Runner.Stop(ServiceCommands.DashboardJob);

    /// <summary>What to run to deploy (PowerShell), shown under each target that is on.</summary>
    private string DeployCommands(string target, bool several)
    {
        var lines = new List<string>();
        if (several)
        {
            lines.Add($"$env:STRATUM_DEPLOY = \"{target}\"");
        }

        if (target == AspireGenerator.DeployDocker)
        {
            lines.Add("aspire deploy                     # " + L("docker compose up en esta máquina", "docker compose up on this machine"));
            lines.Add("aspire publish -o deploy/docker   # " + L("solo los archivos, para otro servidor", "only the files, for another server"));
        }
        else
        {
            lines.Add("az login");
            lines.Add("aspire deploy                     # " + L("crea los recursos y despliega", "creates the resources and deploys"));
        }

        return string.Join("\n", lines);
    }

    private void SetDeploy(string target, bool on)
    {
        try
        {
            error = null;
            aspire = State.SetDeploy(systemName, target, on);
        }
        catch (StratumException ex)
        {
            error = ex.Message;
        }
    }

    private void GenerateAppHost()
    {
        try
        {
            error = null;
            aspire = State.GenerateAppHost(systemName);
        }
        catch (StratumException ex)
        {
            error = ex.Message;
        }
    }
}
