@page "/entities"
@implements IDisposable
@inject StudioState State
@inject NavigationManager Nav

<PageTitle>@L("Entidades", "Entities") · Stratum Studio</PageTitle>

@if (State.Current is not { } draft)
{
    <main class="content"><p class="lead">@L(@<text>No hay ningún servicio abierto. Elige uno en <a href="services">Servicios</a>.</text>, @<text>No service is open. Pick one in <a href="services">Services</a>.</text>)</p></main>
}
else
{
    var entity = Selected;
    <main class="content">
        <div>
            <div class="row" style="justify-content: space-between; align-items: center">
                <h1>@L("Entidades", "Entities")</h1>
                <div class="row" style="gap: 8px">
                    @if (!draft.IsNew && State.Plan is { Changes.Count: > 0 })
                    {
                        <button type="button" class="btn" @onclick="State.Discard">@L("Descartar cambios", "Discard changes")</button>
                        <a class="btn btn-primary" href="apply">@L("Revisar y aplicar →", "Review and apply →")</a>
                    }
                    else if (!draft.IsNew)
                    {
                        <a class="btn" href="@($"/entity-designer?service={Uri.EscapeDataString(draft.Directory)}")" target="stratum-entities" style="text-decoration: none"
                           title="@L("Las entidades y sus relaciones (1–N, 1–1, composición) en un lienzo, en una ventana aparte", "The entities and their relations (1–N, 1–1, composition) on a canvas, in a separate window")"
                           onclick="window.open(this.href, 'stratum-entities', 'popup,width=1440,height=900'); return false;"><Icon Name="entities" /> @L("Diseñador de entidades", "Entity designer")</a>
                    }
                </div>
            </div>
            <p class="lead">@L(@<text>Crea entidades o cambia las que ya existen: Stratum regenera sus archivos <span class="mono">.g.cs</span> y nunca toca tu código (las clases <span class="mono">partial</span> sin <span class="mono">.g</span>). Nada se escribe hasta que revisas y aplicas.</text>, @<text>Create entities or change the ones that exist: Stratum regenerates their <span class="mono">.g.cs</span> files and never touches your code (the <span class="mono">partial</span> classes without <span class="mono">.g</span>). Nothing is written until you review and apply.</text>)</p>
        </div>

        <div class="row" role="tablist" aria-label="@L("Entidades", "Entities")">
            @foreach (var e in draft.Entities)
            {
                <button type="button" role="tab" aria-selected="@(e == entity ? "true" : "false")"
                        class="card @(e == entity ? "selected" : e.IsNew ? "new" : "")" style="padding: 10px 14px"
                        @onclick="() => State.SelectedEntity = e.Name">
                    <b style="@(e.Removed ? "text-decoration: line-through" : "")">@e.Name @if (e.IsNew) { <small style="color: var(--warn)">@L("NUEVA", "NEW")</small> } else if (e.Removed) { <small style="color: var(--err)">@L("ELIMINAR", "REMOVE")</small> } else if (e.IsLegacy && !e.Convert) { <small class="hint">@L("ANTERIOR A 0.10", "BEFORE 0.10")</small> } else if (e.Convert) { <small style="color: var(--warn)">@L("CONVERTIR", "CONVERT")</small> }</b>
                    <small>@e.Properties.Count @L("propiedad(es)", "property(ies)")</small>
                </button>
            }
            <button type="button" class="btn btn-dashed" @onclick="() => State.AddEntity()">@L("+ Nueva entidad", "+ New entity")</button>
        </div>

        @if (entity is null)
        {
            <p class="lead">@L("Este servicio aún no tiene entidades. Crea la primera: Stratum generará la persistencia, los endpoints CRUD y sus tests.", "This service has no entities yet. Create the first one: Stratum will generate the persistence, the CRUD endpoints and their tests.")</p>
        }
        else
        {
            <div class="row" style="align-items: flex-end">
                <label class="field">
                    @L("Nombre (singular)", "Name (singular)")
                    <input type="text" value="@entity.Name" disabled="@(!entity.IsNew)" style="font-size: 18px; font-weight: 600"
                           @onchange="e => Rename(entity, e.Value?.ToString())" />
                </label>
                <label class="field">
                    Plural
                    <input type="text" value="@entity.Plural" placeholder="@entity.EffectivePlural" disabled="@(!entity.IsNew)"
                           @onchange="e => { entity.Plural = e.Value?.ToString() ?? string.Empty; State.Recompute(); }" />
                </label>
                <div class="field">
                    Endpoints
                    <span class="mono" style="min-height: 42px; display: flex; align-items: center; color: var(--text-2); font-weight: 400">/api/v1/@Route(entity)</span>
                </div>
                @if (!entity.Removed)
                {
                    <button type="button" class="btn" style="color: var(--err)" @onclick="() => State.RemoveEntity(entity)">@(entity.IsNew ? L("Quitar entidad", "Remove entity") : L("Eliminar entidad", "Delete entity"))</button>
                }
            </div>

            @if (entity.Removed)
            {
                <div class="msg warn" role="status">
                    @L(@<text><b>@entity.Name se eliminará al aplicar.</b> Stratum borra sus archivos <span class="mono">.g.cs</span> y la quita de stratum.json; la próxima migración borrará su tabla.</text>, @<text><b>@entity.Name will be deleted when applying.</b> Stratum deletes its <span class="mono">.g.cs</span> files and removes it from stratum.json; the next migration will drop its table.</text>)
                    @if (State.ConsumersOf(draft, entity.Name) is { Count: > 0 } consumers)
                    {
                        <br /><span>@L(@<text>Escuchan sus eventos: <b>@string.Join(", ", consumers)</b>. Después, quítales esas suscripciones en su <em>Mensajería</em> (aparecerán marcadas) o con <span class="mono">stratum subscribe --sync --prune</span>.</text>, @<text>Its events are listened to by <b>@string.Join(", ", consumers)</b>. Then remove those subscriptions in their <em>Messaging</em> (they'll be flagged) or with <span class="mono">stratum subscribe --sync --prune</span>.</text>)</span>
                    }
                    <div class="row" style="margin-top: 10px">
                        <label class="row" style="gap: 8px"><input type="checkbox" checked="@draft.DeleteOwnFiles" @onchange="e => { draft.DeleteOwnFiles = e.Value is true; State.Recompute(); }" /> @L("Borrar también mis archivos de esta entidad (handlers, repositorio, endpoints propios…)", "Also delete my files of this entity (handlers, repository, own endpoints…)")</label>
                        <button type="button" class="btn" @onclick="() => State.RemoveEntity(entity)">@L("Restaurar", "Restore")</button>
                    </div>
                </div>
            }
            else if (entity.IsLegacy && !entity.Convert)
            {
                <div class="msg warn" role="status">
                    @L(@<text><b>Creada con una versión de Stratum anterior a la 0.10.</b> Su código está en archivos tuyos, así que Stratum no puede cambiar sus propiedades sin pisarlos.
                    Al convertirla, Stratum mueve propiedades, contratos y CRUD a archivos <span class="mono">.g.cs</span> y deja clases <span class="mono">partial</span> vacías para tu código.
                    Verás qué archivos se reemplazan o borran antes de aplicar; si los habías personalizado, pasa esos cambios a las clases partial.</text>, @<text><b>Created with a Stratum version before 0.10.</b> Its code is in your files, so Stratum can't change its properties without overwriting them.
                    Converting it moves properties, contracts and CRUD to <span class="mono">.g.cs</span> files and leaves empty <span class="mono">partial</span> classes for your code.
                    You'll see which files are replaced or deleted before applying; if you had customized them, move those changes to the partial classes.</text>)
                    <div class="row" style="margin-top: 10px">
                        <button type="button" class="btn btn-primary" @onclick="() => { entity.Convert = true; State.Recompute(); }">@L("Convertir al formato editable", "Convert to the editable format")</button>
                    </div>
                </div>
            }

            <section class="stack" aria-labelledby="h-props">
                <div class="row" style="justify-content: space-between; align-items: center">
                    <h2 class="section" id="h-props" style="margin: 0">@L("Propiedades", "Properties")</h2>
                    @if (entity.CanEdit)
                    {
                        <button type="button" class="btn btn-dashed" @onclick="() => propertyEditor = EntityEditors.PropertyEditor.New(entity)">@L("+ Añadir propiedad", "+ Add property")</button>
                    }
                </div>
                <div class="table">
                    <div class="tr head" style="@PropColumns"><span>@L("Nombre", "Name")</span><span>@L("Tipo", "Type")</span><span>@L("Valor", "Value")</span><span>@L("Genera", "Generates")</span><span></span></div>
                    <div class="tr" style="@PropColumns"><span class="auto">Id</span><span class="auto">guid</span><span class="hint">—</span><span class="hint">@L("UUID v7 · clave primaria", "UUID v7 · primary key")</span><span class="hint">auto</span></div>
                    @foreach (var p in entity.Properties)
                    {
                        <div class="tr" style="@PropColumns">
                            <span class="stack" style="gap: 2px">
                                @if (entity.CanEdit)
                                {
                                    <button type="button" class="link-row mono" title="@L("Editar", "Edit")" @onclick="() => propertyEditor = EntityEditors.PropertyEditor.For(p)">@p.Name</button>
                                }
                                else
                                {
                                    <span class="mono">@p.Name</span>
                                }
                                @if (p.IsRenamed)
                                {
                                    <small class="hint" style="color: var(--warn)">@L("renombrada · antes", "renamed · was") @p.OriginalName</small>
                                }
                                else if (p.OriginalName is null && !entity.IsNew)
                                {
                                    <small class="hint" style="color: var(--ok)">@L("nueva", "new")</small>
                                }
                            </span>
                            <span class="mono">@(p.References is { } t ? $"→ {t}{(p.OneToOne ? " (1–1)" : string.Empty)}" : p.Item is { } it ? $"▤ {it}{(p.IsList ? "[]" : string.Empty)}" : p.Enum is { } en ? "# " + en : p.Type)</span>
                            <span>@(p.IsList ? L("Lista", "List") : p.Nullable ? L("Opcional", "Optional") : L("Obligatorio", "Required"))</span>
                            <span class="hint">@EntityEditors.Generates(p)</span>
                            @if (entity.CanEdit)
                            {
                                <span class="row-actions">
                                    <button type="button" class="icon-btn edit" aria-label="@L($"Editar {p.Name}", $"Edit {p.Name}")" title="@L("Editar", "Edit")" @onclick="() => propertyEditor = EntityEditors.PropertyEditor.For(p)">✎</button>
                                    <button type="button" class="icon-btn" aria-label="@L($"Eliminar {p.Name}", $"Delete {p.Name}")" title="@L("Eliminar", "Delete")" @onclick="() => { entity.Properties.Remove(p); State.Recompute(); }">×</button>
                                </span>
                            }
                            else
                            {
                                <span></span>
                            }
                        </div>
                    }
                    <div class="tr" style="@PropColumns"><span class="auto">CreatedAt · UpdatedAt</span><span class="auto">datetime</span><span class="hint">—</span><span class="hint">@L("Auditoría automática", "Automatic audit")</span><span class="hint">auto</span></div>
                </div>
                @if (entity.CanEdit && !entity.IsNew)
                {
                    <span class="hint">@L("Para renombrar, edita la propiedad y cámbiale el nombre: la migración conserva los datos. Si la eliminas y creas otra, la columna se borra.", "To rename, edit the property and change its name: the migration keeps the data. If you delete it and create another, the column is dropped.")</span>
                }
            </section>

            <section class="stack" aria-labelledby="h-events">
                <h2 class="section" id="h-events">@L("Eventos para otros servicios", "Events for other services")</h2>
                @if (draft.BrokerNote is { } brokerNote)
                {
                    <span class="hint" style="color: var(--accent)">ℹ @brokerNote</span>
                }
                @{
                    <label class="row" style="gap: 8px">
                        <input type="checkbox" checked="@entity.PublishEvents" disabled="@(!entity.CanEdit)"
                               @onchange="e => SetPublishEvents(draft, entity, e)" />
                        @L(@<text>Publicar <span class="mono">@(entity.Name)Created</span>, <span class="mono">@(entity.Name)Updated</span> y <span class="mono">@(entity.Name)Deleted</span> con sus datos</text>, @<text>Publish <span class="mono">@(entity.Name)Created</span>, <span class="mono">@(entity.Name)Updated</span> and <span class="mono">@(entity.Name)Deleted</span> with their data</text>)
                    </label>
                    @if (entity.PublishEvents)
                    {
                        var service = ServiceName.ToKebab(draft.Name);
                        var name = System.Text.RegularExpressions.Regex.Replace(entity.Name, "(?<=[a-z0-9])([A-Z])", "-$1").ToLowerInvariant();
                        <span class="hint">Topics: <span class="mono">@($"{service}.{name}-created")</span>, <span class="mono">-updated</span>, <span class="mono">-deleted</span>. @L("Se guardan en el outbox en la misma transacción que el cambio y se envían después, con reintentos.", "They are stored in the outbox in the same transaction as the change and sent afterwards, with retries.")</span>
                    }
                }
            </section>

            @if (draft.Architecture == Architectures.CleanDdd)
            {
                <section class="stack" aria-labelledby="h-behavior">
                    <h2 class="section" id="h-behavior">@L("Comportamiento", "Behavior") · Clean + DDD</h2>
                    <div class="table">
                        <div class="tr head" style="grid-template-columns: 2fr 1.4fr 2fr"><span>@L("Método del agregado", "Aggregate method")</span><span>@L("Modifica", "Changes")</span><span>@L("Evento de dominio", "Domain event")</span></div>
                        <div class="tr" style="grid-template-columns: 2fr 1.4fr 2fr"><span class="mono">@(entity.Name).Create(…) <small class="hint">@L("fábrica", "factory")</small></span><span class="hint">@L("todas", "all")</span><span class="mono" style="color: #67E8F9">@(entity.Name)Created</span></div>
                        <div class="tr" style="grid-template-columns: 2fr 1.4fr 2fr"><span class="mono">Update(…)</span><span class="hint">@L("todas", "all")</span><span class="mono" style="color: #67E8F9">@(entity.Name)Updated</span></div>
                        <div class="tr" style="grid-template-columns: 2fr 1.4fr 2fr"><span class="mono">Delete()</span><span class="hint">—</span><span class="mono" style="color: #67E8F9">@(entity.Name)Deleted</span></div>
                        @foreach (var o in entity.Operations.Where(o => !string.IsNullOrWhiteSpace(o.Name)))
                        {
                            var name = SafePascal(o.Name);
                            <div class="tr" style="grid-template-columns: 2fr 1.4fr 2fr">
                                <span class="mono">@(name)(@o.Parameters) <small class="hint">@L("operación", "operation")</small></span>
                                <span class="hint">@L("tu regla ·", "your rule ·")
                                    @if (State.FindServiceFile($"{entity.Name}.{name}.cs") is { } ruleFile)
                                    {
                                        <OpenInEditor Path="@ruleFile" Label="@($"{entity.Name}.{name}.cs")" Compact="true" />
                                    }
                                    else
                                    {
                                        <span class="mono">@(entity.Name).@(name).cs</span>
                                    }
                                </span>
                                <span class="mono" style="color: #67E8F9">@(string.IsNullOrWhiteSpace(o.Event) ? ModelRules.DefaultEvent(entity.Name, name) : o.Event)</span>
                            </div>
                        }
                    </div>
                    <span class="hint">@L(@<text>Las reglas de negocio van en <span class="mono">EnsureInvariants()</span> de <span class="mono">@(entity.Name).cs</span> (tu parte del agregado, Stratum la crea una vez y no la toca), y los efectos de cada evento en su handler de <span class="mono">@(draft.Name).Application/@Plural(entity)</span>.</text>, @<text>Business rules go in <span class="mono">EnsureInvariants()</span> of <span class="mono">@(entity.Name).cs</span> (your part of the aggregate: Stratum creates it once and doesn't touch it), and the effects of each event in its handler in <span class="mono">@(draft.Name).Application/@Plural(entity)</span>.</text>)</span>
                </section>

                <section class="stack" aria-labelledby="h-operations">
                    <div class="row" style="justify-content: space-between; align-items: center">
                        <h2 class="section" id="h-operations" style="margin: 0">@L("Operaciones del agregado", "Aggregate operations")</h2>
                        @if (entity.CanEdit)
                        {
                            <button type="button" class="btn btn-dashed" @onclick="() => operationEditor = new EntityEditors.OperationEditor()">@L("+ Añadir operación", "+ Add operation")</button>
                        }
                    </div>
                    <span class="hint">@L(@<text>Acciones de negocio como <span class="mono">Confirm</span> o <span class="mono">Cancel(Reason)</span>, cada una con su comando, su evento y <span class="mono">POST /api/v1/@Route(entity)/{id}/&lt;operación&gt;</span>. La regla la escribes tú en <span class="mono">@(entity.Name).&lt;Operación&gt;.cs</span>.</text>, @<text>Business actions like <span class="mono">Confirm</span> or <span class="mono">Cancel(Reason)</span>, each with its command, its event and <span class="mono">POST /api/v1/@Route(entity)/{id}/&lt;operation&gt;</span>. You write the rule in <span class="mono">@(entity.Name).&lt;Operation&gt;.cs</span>.</text>)</span>
                    @if (entity.Operations.Count > 0)
                    {
                        <div class="table">
                            <div class="tr head" style="@OpColumns"><span>@L("Operación", "Operation")</span><span>@L("Parámetros", "Parameters")</span><span>@L("Evento", "Event")</span><span>@L("Publica", "Publishes")</span><span></span></div>
                            @foreach (var o in entity.Operations)
                            {
                                <div class="tr" style="@OpColumns">
                                    @if (entity.CanEdit)
                                    {
                                        <button type="button" class="link-row mono" title="@L("Editar", "Edit")" @onclick="() => operationEditor = EntityEditors.OperationEditor.For(o)">@o.Name</button>
                                    }
                                    else
                                    {
                                        <span class="mono">@o.Name</span>
                                    }
                                    <span class="mono hint">@(string.IsNullOrWhiteSpace(o.Parameters) ? "—" : o.Parameters)</span>
                                    <span class="mono" style="color: #67E8F9">@(string.IsNullOrWhiteSpace(o.Event) ? ModelRules.DefaultEvent(entity.Name, SafePascal(o.Name)) : o.Event)</span>
                                    <span class="@(o.Publish ? null : "hint")">@(o.Publish ? L("Sí", "Yes") : "No")</span>
                                    @if (entity.CanEdit)
                                    {
                                        <span class="row-actions">
                                            <button type="button" class="icon-btn edit" aria-label="@L($"Editar {o.Name}", $"Edit {o.Name}")" title="@L("Editar", "Edit")" @onclick="() => operationEditor = EntityEditors.OperationEditor.For(o)">✎</button>
                                            <button type="button" class="icon-btn" aria-label="@L($"Quitar {o.Name}", $"Remove {o.Name}")" title="@L("Quitar", "Remove")" @onclick="() => { entity.Operations.Remove(o); State.Recompute(); }">×</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        }

        <section class="stack" aria-labelledby="h-enums">
            <div class="row" style="justify-content: space-between; align-items: center">
                <h2 class="section" id="h-enums" style="margin: 0">@L("Enumerados del servicio", "Enumerations of the service")</h2>
                <button type="button" class="btn btn-dashed" @onclick="() => enumEditor = EntityEditors.EnumEditor.New()">@L("+ Nuevo enumerado", "+ New enumeration")</button>
            </div>
            @if (draft.Enums.Count == 0)
            {
                <span class="hint">@L("Listas de valores fijos, como el estado de un pedido. Se usan como tipo de una propiedad", "Lists of fixed values, like the status of an order. Used as the type of a property") (<span class="mono"># OrderStatus</span>).</span>
            }
            else
            {
                <div class="table">
                    <div class="tr head" style="@ListColumns"><span>@L("Nombre", "Name")</span><span>@L("Valores", "Values")</span><span>@L("Lo usan", "Used by")</span><span></span></div>
                    @foreach (var en in draft.Enums)
                    {
                        var usages = Usages(draft, en);
                        <div class="tr" style="@ListColumns">
                            <button type="button" class="link-row mono" title="@L("Editar", "Edit")" @onclick="() => enumEditor = EntityEditors.EnumEditor.For(en)">@en.Name</button>
                            <span class="mono hint">@en.Values</span>
                            <span class="hint mono">@(usages.Count == 0 ? "—" : string.Join(", ", usages))</span>
                            <span class="row-actions">
                                <button type="button" class="icon-btn edit" aria-label="@L($"Editar {en.Name}", $"Edit {en.Name}")" title="@L("Editar", "Edit")" @onclick="() => enumEditor = EntityEditors.EnumEditor.For(en)">✎</button>
                                <button type="button" class="icon-btn" aria-label="@L($"Quitar {en.Name}", $"Remove {en.Name}")" disabled="@(usages.Count > 0)"
                                        title="@(usages.Count > 0 ? L("Cambia antes el tipo de las propiedades que lo usan", "First change the type of the properties that use it") : L("Quitar", "Remove"))"
                                        @onclick="() => { draft.Enums.Remove(en); State.Recompute(); }">×</button>
                            </span>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="stack" aria-labelledby="h-types">
            <div class="row" style="justify-content: space-between; align-items: center">
                <h2 class="section" id="h-types" style="margin: 0">@L("Tipos de elemento (listas de objetos)", "Item types (lists of objects)")</h2>
                <button type="button" class="btn btn-dashed" @onclick="() => typeEditor = EntityEditors.TypeEditor.New()">@L("+ Nuevo tipo de elemento", "+ New item type")</button>
            </div>
            @if (draft.Types.Count == 0)
            {
                <span class="hint">@L("Para listas cuyos elementos tienen varios campos, como las líneas de un pedido", "For lists whose items have several fields, like the lines of an order") (<span class="mono">▤ OrderLine[]</span>).</span>
            }
            else
            {
                <div class="table">
                    <div class="tr head" style="@ListColumns"><span>@L("Nombre", "Name")</span><span>@L("Propiedades", "Properties")</span><span>@L("Lo usan", "Used by")</span><span></span></div>
                    @foreach (var type in draft.Types)
                    {
                        var usages = Usages(draft, type);
                        <div class="tr" style="@ListColumns">
                            <button type="button" class="link-row mono" title="@L("Editar", "Edit")" @onclick="() => typeEditor = EntityEditors.TypeEditor.For(type)">@type.Name</button>
                            <span class="mono hint">@type.Properties</span>
                            <span class="hint mono">@(usages.Count == 0 ? "—" : string.Join(", ", usages))</span>
                            <span class="row-actions">
                                <button type="button" class="icon-btn edit" aria-label="@L($"Editar {type.Name}", $"Edit {type.Name}")" title="@L("Editar", "Edit")" @onclick="() => typeEditor = EntityEditors.TypeEditor.For(type)">✎</button>
                                <button type="button" class="icon-btn" aria-label="@L($"Quitar {type.Name}", $"Remove {type.Name}")" disabled="@(usages.Count > 0)"
                                        title="@(usages.Count > 0 ? L("Cambia antes el tipo de las propiedades que lo usan", "First change the type of the properties that use it") : L("Quitar", "Remove"))"
                                        @onclick="() => { draft.Types.Remove(type); State.Recompute(); }">×</button>
                            </span>
                        </div>
                    }
                </div>
            }
        </section>

        <ProblemList />
    </main>

    @if (entity is not null && propertyEditor is not null)
    {
        <PropertyDialog Editor="propertyEditor" Entity="entity" Draft="draft" OnSaved="Saved" OnClose="() => propertyEditor = null"
                        OnNewEnum="() => enumEditor = EntityEditors.EnumEditor.New()" OnNewType="() => typeEditor = EntityEditors.TypeEditor.New()" />
    }
    @if (entity is not null && operationEditor is not null)
    {
        <OperationDialog Editor="operationEditor" Entity="entity" Draft="draft" OnSaved="() => OperationSaved(draft, entity)" OnClose="() => operationEditor = null" />
    }
    @if (enumEditor is not null)
    {
        <EnumDialog Editor="enumEditor" Draft="draft" OnSaved="EnumSaved" OnClose="() => enumEditor = null" />
    }
    @if (typeEditor is not null)
    {
        <TypeDialog Editor="typeEditor" Draft="draft" OnSaved="TypeSaved" OnClose="() => typeEditor = null" />
    }

