    // The open dialogs (at most one per kind; an enum or item type dialog can open on top of the property one).
    private EntityEditors.PropertyEditor? propertyEditor;
    private EntityEditors.OperationEditor? operationEditor;
    private EntityEditors.EnumEditor? enumEditor;
    private EntityEditors.TypeEditor? typeEditor;

    private void Saved()
