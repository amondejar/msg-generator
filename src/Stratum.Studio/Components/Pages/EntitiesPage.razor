        }

        operationEditor = null;
        State.Recompute();
    }

    /// <summary>A new enumeration created from the property dialog becomes that property's type.</summary>
    private void EnumSaved(string name)
    {
        if (enumEditor is { Original: null } && propertyEditor is not null)
        {
            propertyEditor.Type = PropertyDraft.EnumPrefix + name;
        }

        enumEditor = null;
        State.Recompute();
    }

    private void TypeSaved(string name)
    {
        if (typeEditor is { Original: null } && propertyEditor is not null)
        {
            propertyEditor.Type = PropertyDraft.ItemPrefix + name;
            propertyEditor.Kind = EntityEditors.List;
        }

        typeEditor = null;
        State.Recompute();
    }

    private EntityDraft? Selected =>
        State.Current?.Entities.FirstOrDefault(e => e.Name == State.SelectedEntity) ?? State.Current?.Entities.FirstOrDefault();

    protected override void OnInitialized()
    {
        State.Initialize();
        State.Changed += OnChanged;
        OpenFromQuery();
    }

    /// <summary>"?dialog=property|property:Name|operation:Name|enum:Name|type:Name" opens that dialog (links and checks).</summary>
    private void OpenFromQuery()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (!query.TryGetValue("dialog", out var value) || State.Current is not { } draft)
        {
            return;
        }

        if (query.TryGetValue("entity", out var selected) && draft.Entities.Any(e => e.Name == selected.ToString()))
        {
            State.SelectedEntity = selected.ToString();
        }

        var parts = value.ToString().Split(':', 2);
        var name = parts.Length > 1 ? parts[1] : null;
        var entity = Selected;
        switch (parts[0])
        {
            case "property" when entity is { CanEdit: true }:
                propertyEditor = entity.Properties.FirstOrDefault(p => p.Name == name) is { } property
                    ? EntityEditors.PropertyEditor.For(property) : EntityEditors.PropertyEditor.New(entity);
                break;
            case "operation" when entity is { CanEdit: true } && draft.Architecture == Architectures.CleanDdd:
                operationEditor = entity.Operations.FirstOrDefault(o => o.Name == name) is { } operation
                    ? EntityEditors.OperationEditor.For(operation) : new EntityEditors.OperationEditor();
                break;
            case "enum":
                enumEditor = draft.Enums.FirstOrDefault(e => e.Name == name) is { } en ? EntityEditors.EnumEditor.For(en) : EntityEditors.EnumEditor.New();
                break;
            case "type":
                typeEditor = draft.Types.FirstOrDefault(t => t.Name == name) is { } type ? EntityEditors.TypeEditor.For(type) : EntityEditors.TypeEditor.New();
                break;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;

    private void Rename(EntityDraft entity, string? name)
    {
        entity.Name = name?.Trim() ?? string.Empty;
        State.SelectedEntity = entity.Name;
