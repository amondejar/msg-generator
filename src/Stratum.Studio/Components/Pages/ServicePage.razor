@page "/service"
@implements IDisposable
@inject StudioState State
@inject NavigationManager Nav

<PageTitle>@L("General", "General") · Stratum Studio</PageTitle>

@if (State.Current is not { } draft)
{
    <main class="content"><p class="lead">@L(@<text>No hay ningún servicio abierto. Elige uno en <a href="services">Servicios</a>.</text>, @<text>No service is open. Pick one in <a href="services">Services</a>.</text>)</p></main>
}
else
{
    <main class="content">
        <div>
            <h1>@(draft.IsNew ? L("Nuevo servicio", "New service") : draft.Name)</h1>
            <p class="lead">
                @if (draft.IsNew)
                {
                    <span>@L(@<text>Elige el nombre, la arquitectura y las features. Nada se crea hasta que pulses <a href="apply">Revisar y aplicar</a>.</text>, @<text>Choose the name, the architecture and the features. Nothing is created until you press <a href="apply">Review and apply</a>.</text>)</span>
                }
                else
                {
                    <span>@L("Arquitectura y features del servicio. Puedes activar o desactivar features cuando quieras: Stratum regenera lo suyo y no pisa tu código. La arquitectura queda fija.", "Architecture and features of the service. You can turn features on or off whenever you want: Stratum regenerates its part and doesn't overwrite your code. The architecture stays fixed.")</span>
                }
            </p>
        </div>

        @if (draft.IsNew)
        {
            <label class="field" style="max-width: 360px">
                @L("Nombre del servicio", "Service name")
                <input type="text" value="@draft.Name" @onchange="e => { draft.Name = e.Value?.ToString() ?? string.Empty; State.Recompute(); }" />
            </label>
        }

        <section class="stack" aria-labelledby="h-arch">
            <h2 class="section" id="h-arch">@L("Arquitectura", "Architecture")</h2>
            @if (!draft.CanEditStructure)
            {
                <span class="hint">@L("Fija: se eligió al crear el servicio. Para cambiarla, crea un servicio nuevo con la otra arquitectura.", "Fixed: chosen when the service was created. To change it, create a new service with the other architecture.")</span>
            }
            <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr))">
                <button type="button" class="card @(draft.Architecture == Architectures.VerticalSlice ? "selected" : "")"
                        aria-pressed="@(draft.Architecture == Architectures.VerticalSlice ? "true" : "false")"
                        disabled="@(!draft.CanEditStructure)" @onclick="() => SetArchitecture(Architectures.VerticalSlice)">
                    <b>Vertical slice</b>
                    <small>@L("Un proyecto, organizado por features. Los endpoints usan EF Core directamente. Ideal para servicios de CRUD.", "One project, organized by features. Endpoints use EF Core directly. Ideal for CRUD services.")</small>
                    <small class="mono">src/@(draft.Name).Api/Features/…</small>
                </button>
                <button type="button" class="card @(draft.Architecture == Architectures.CleanDdd ? "selected" : "")"
                        aria-pressed="@(draft.Architecture == Architectures.CleanDdd ? "true" : "false")"
                        disabled="@(!draft.CanEditStructure)" @onclick="() => SetArchitecture(Architectures.CleanDdd)">
                    <b>Clean + DDD</b>
                    <small>@L("Agregados con comportamiento, eventos de dominio y casos de uso. Dependencias hacia el dominio.", "Aggregates with behavior, domain events and use cases. Dependencies point to the domain.")</small>
                    <small class="mono">Domain · Application · Infrastructure · Api</small>
                </button>
            </div>
        </section>

        <section class="stack" aria-labelledby="h-features">
            <h2 class="section" id="h-features">Features</h2>
            @if (!draft.CanEditFeatures)
            {
                <div class="msg warn" role="status">
                    @L(@<text><b>Program.cs es de una versión de Stratum anterior a la 0.12</b> y configura las features a mano, así que Stratum no puede cambiarlas sin pisarlo.
                    Al pasarlo a <span class="mono">StratumWiring.g.cs</span>, Program.cs queda en unas pocas líneas (<span class="mono">builder.AddStratumWiring()</span>, <span class="mono">app.UseStratumWiring()</span>) y las features se activan y desactivan desde aquí.
                    Si habías añadido código propio en Program.cs, el diff te enseña tu versión para volver a ponerlo.</text>, @<text><b>Program.cs comes from a Stratum version before 0.12</b> and configures the features by hand, so Stratum can't change them without overwriting it.
                    Moving it to <span class="mono">StratumWiring.g.cs</span> leaves Program.cs in a few lines (<span class="mono">builder.AddStratumWiring()</span>, <span class="mono">app.UseStratumWiring()</span>) and features are turned on and off from here.
                    If you had added your own code to Program.cs, the diff shows your version so you can put it back.</text>)
                    <div class="row" style="margin-top: 10px">
                        <button type="button" class="btn btn-primary" @onclick="() => { draft.ConvertWiring = true; State.Recompute(); }">@L("Pasar Program.cs a StratumWiring", "Move Program.cs to StratumWiring")</button>
                    </div>
                </div>
            }
            else if (!draft.IsNew)
            {
                <span class="hint">@L("Al desactivar una feature, Stratum quita sus paquetes y borra sus archivos solo si siguen como él los generó; si los cambiaste, te avisa en lugar de borrarlos.", "When a feature is turned off, Stratum removes its packages and deletes its files only if they are still as it generated them; if you changed them, it warns you instead of deleting them.")</span>
            }
            <div class="grid">
                @foreach (var (key, name, description, package) in FeatureList)
                {
                    var on = draft.Features.IsEnabled(key);
                    <div class="card feature">
                        <button type="button" class="switch" aria-pressed="@(on ? "true" : "false")" aria-label="@((on ? L("Desactivar ", "Turn off ") : L("Activar ", "Turn on ")) + name)"
                                disabled="@(!draft.CanEditFeatures)" @onclick="() => Toggle(key, !on)"></button>
                        <div class="stack" style="gap: 4px; min-width: 0">
                            <b>@name</b>
                            <small>@description</small>
                            <small class="mono">@package</small>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="stack" aria-labelledby="h-next">
            <h2 class="section" id="h-next">@L("Del servicio", "Of the service")</h2>
            <div class="actions">
                <a class="action" href="entities"><Icon Name="entities" Size="20" /><span><b>@L("Entidades", "Entities") · @draft.Entities.Count</b><small>@L("Propiedades, CRUD, reglas y eventos que publica.", "Properties, CRUD, rules and events it publishes.")</small></span></a>
                <a class="action" href="service/data"><Icon Name="data" Size="20" /><span><b>@L("Datos y migraciones", "Data and migrations")</b><small>@(draft.Entities.Count == 0 ? L("La base de datos se fija con la primera entidad.", "The database is set with the first entity.") : L($"{draft.Provider} · migraciones guiadas", $"{draft.Provider} · guided migrations"))</small></span></a>
                <a class="action" href="service/messaging"><Icon Name="messaging" Size="20" /><span><b>@L("Mensajería", "Messaging")</b><small>@(draft.Broker is null ? L("Desactivada", "Off") : L($"{draft.Broker} · escucha {draft.Subscriptions.Count} evento(s)", $"{draft.Broker} · listens to {draft.Subscriptions.Count} event(s)"))</small></span></a>
                <a class="action" href="service/code"><Icon Name="code" Size="20" /><span><b>@L("Código generado", "Generated code")</b><small>@L("Program.cs, árbol de archivos y stratum.json.", "Program.cs, file tree and stratum.json.")</small></span></a>
            </div>
        </section>

        <ProblemList />

        @if (!draft.IsNew)
        {
            <section class="stack" aria-labelledby="h-danger">
                <h2 class="section" id="h-danger" style="color: var(--err)">@L("Zona peligrosa", "Danger zone")</h2>
                <div class="card row" style="justify-content: space-between; border-color: #5B1A1A">
                    <span>
                        <b>@L("Eliminar el servicio", "Delete the service")</b><br />
                        <small class="hint">@L("Su carpeta, las suscripciones de otros servicios a sus eventos y su sitio en el AppHost. Verás todo antes de confirmar.", "Its folder, other services' subscriptions to its events and its place in the AppHost. You'll see everything before confirming.")</small>
                    </span>
                    <a class="btn" style="color: var(--err); border-color: #7F1D1D" href="service/remove">@L("Eliminar", "Delete") @draft.Name…</a>
                </div>
            </section>
        }
    </main>
}

@code {
    private static (string Key, string Name, string Description, string Package)[] FeatureList =>
    [
        ("observability", L("Observabilidad", "Observability"), L("Trazas, métricas y logs con OpenTelemetry. Aspire las muestra en su dashboard.", "Traces, metrics and logs with OpenTelemetry. Aspire shows them in its dashboard."), "Stratum.ServiceDefaults.OpenTelemetry"),
        ("openApi", "OpenAPI + Scalar", L("Documento /openapi/v1.json y Scalar en /scalar para explorar y probar la API.", "/openapi/v1.json document and Scalar at /scalar to explore and try the API."), "Microsoft.AspNetCore.OpenApi · Scalar.AspNetCore"),
        ("resilience", L("Clientes HTTP", "HTTP clients"), L("Reintentos, timeout, circuit breaker y service discovery en todos los HttpClient.", "Retries, timeout, circuit breaker and service discovery on every HttpClient."), "Stratum.ServiceDefaults.Resilience"),
        ("auth", L("Autenticación", "Authentication"), L("JWT bearer. Todo autenticado por defecto salvo los health checks.", "JWT bearer. Everything authenticated by default except the health checks."), "Stratum.ServiceDefaults.Authentication"),
        ("tests", "Tests", L("Tests de integración del contrato común y de cada entidad.", "Integration tests of the common contract and of each entity."), "xUnit · WebApplicationFactory"),
        ("docker", "Docker", L("Dockerfile multi-stage con usuario no-root.", "Multi-stage Dockerfile with a non-root user."), "Dockerfile"),
        ("ci", "CI", L("GitHub Actions: build, test y auditoría de paquetes.", "GitHub Actions: build, test and package audit."), ".github/workflows/ci.yml"),
        ("mcp", L("Servidor MCP", "MCP server"), L("/mcp: el CRUD y las operaciones de las entidades como herramientas para asistentes de IA (con la misma autenticación que la API).", "/mcp: the entities' CRUD and operations as tools for AI assistants (with the same authentication as the API)."), "ModelContextProtocol.AspNetCore"),
    ];

    protected override void OnInitialized()
    {
        State.Initialize();
        State.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;

    private void SetArchitecture(string architecture)
    {
        State.Current!.Architecture = architecture;
        State.Recompute();
    }

    private void Toggle(string feature, bool enabled)
    {
        State.Current!.Features = State.Current.Features.With(feature, enabled);
        State.Recompute();
    }

}
