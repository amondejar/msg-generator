@page "/apply"
@implements IDisposable
@inject StudioState State

<PageTitle>@L("Revisar y aplicar", "Review and apply") · Stratum Studio</PageTitle>

@if (State.Current is not { } draft)
{
    <main class="content"><p class="lead">@L(@<text>No hay ningún servicio abierto. Elige uno en <a href="services">Servicios</a>.</text>, @<text>No service is open. Pick one in <a href="services">Services</a>.</text>)</p></main>
}
else
{
    var plan = State.Plan;
    var changes = plan?.Changes ?? [];
    <main class="content">
        <div class="row" style="justify-content: space-between; align-items: flex-end">
            <div>
                <h1>@L("Revisar y aplicar", "Review and apply")</h1>
                <p class="lead">
                    @(draft.IsNew ? L($"Servicio nuevo {draft.Name} en la carpeta {draft.Directory}.", $"New service {draft.Name} in the folder {draft.Directory}.") : L($"Cambios en {draft.Name}.", $"Changes in {draft.Name}."))
                    @L("Revisa qué va a escribir Stratum en tu repositorio.", "Review what Stratum is going to write in your repository.")
                </p>
            </div>
            @if (plan is null || changes.Count > 0)
            {
                <div class="stack" style="gap: 4px; align-items: flex-end">
                    <button type="button" class="btn btn-primary" style="min-height: 44px" disabled="@(plan is null)" @onclick="Apply">
                        @L("Aplicar al repositorio", "Apply to the repository")
                    </button>
                    @if (plan is null)
                    {
                        <span class="hint" style="color: var(--err)">@L("Corrige los problemas de abajo para poder aplicar.", "Fix the problems below to be able to apply.")</span>
                    }
                </div>
            }
        </div>

        @if (State.LastMessage is { } message)
        {
            <div class="msg ok" role="status">
                @message
                <div class="row" style="margin-top: 10px">
                    @if (draft.Entities.Count > 0)
                    {
                        <a class="btn" href="service/data">@L("Crear la migración →", "Create the migration →")</a>
                    }
                    <a class="btn" href="run">@L("Ejecutar el sistema →", "Run the system →")</a>
                    <span class="mono hint">@L("o:", "or:") dotnet test @(draft.Directory)</span>
                </div>
            </div>
        }

        <ProblemList />

        @if (plan is not null && changes.Count == 0)
        {
            <div class="card stack" style="gap: 6px">
                <b>@L("✔ Todo está escrito", "✔ Everything is written")</b>
                <span class="hint">@L(@<text>El código de @draft.Name coincide con su stratum.json. Cambia algo en <a href="service">General</a>, <a href="entities">Entidades</a> o <a href="service/messaging">Mensajería</a> y vuelve aquí para ver qué escribiría Stratum.</text>, @<text>The code of @draft.Name matches its stratum.json. Change something in <a href="service">General</a>, <a href="entities">Entities</a> or <a href="service/messaging">Messaging</a> and come back here to see what Stratum would write.</text>)</span>
            </div>
        }
        else if (plan is not null)
        {
            <div class="stats">
                <div class="card"><b style="color: var(--ok)">@Count(changes, ChangeKind.Create)</b>@L("archivos nuevos", "new files")</div>
                <div class="card"><b style="color: var(--warn)">@Count(changes, ChangeKind.Regenerate)</b>@L("regenerados por Stratum", "regenerated by Stratum")</div>
                <div class="card"><b style="color: #67E8F9">@Count(changes, ChangeKind.Merge)</b>@L("completados (solo se añade)", "completed (only added to)")</div>
                <div class="card"><b style="@(changes.Any(c => c.TouchesUserCode) ? "color: var(--err)" : "")">@changes.Count(c => c.TouchesUserCode)</b>@L("archivos tuyos reemplazados o borrados", "of your files replaced or deleted")</div>
            </div>

            @foreach (var (kind, title, css, symbol) in Groups)
            {
                var group = changes.Where(c => c.Kind == kind).ToList();
                if (group.Count == 0) { continue; }
                <section class="stack" style="gap: 8px">
                    <h2 class="section">@title</h2>
                    <div class="files">
                        @foreach (var change in group)
                        {
                            <button type="button" class="@(change.Path == selected?.Path ? "sel" : "")" @onclick="() => selectedPath = change.Path">
                                <span class="@css">@symbol</span> @change.Path @if (change.TouchesUserCode) { <small style="color: var(--err)">· @L("tuyo", "yours")</small> }
                            </button>
                        }
                    </div>
                </section>
            }

            @foreach (var warning in plan.Warnings)
            {
                <div class="msg warn" role="note">⚠ @warning</div>
            }
        }
    </main>

    <aside class="preview" aria-label="@L("Diferencias", "Differences")">
        @if (selected is { } current)
        {
            <div class="hint mono" style="padding: 12px 20px; border-bottom: 1px solid var(--line)">@current.Path</div>
            <pre class="code">@foreach (var line in CodeView.Diff(current.Previous, current.Content))
{<span class="@LineCss(line.Kind)">@(Prefix(line.Kind))@line.Text</span>}</pre>
        }
        else
        {
            <p class="hint" style="padding: 16px 20px">@L("Selecciona un archivo para ver qué cambia.", "Select a file to see what changes.")</p>
        }
    </aside>
}

@code {
    private static (ChangeKind Kind, string Title, string Css, string Symbol)[] Groups =>
    [
        (ChangeKind.Create, L("Nuevos · a partir de ahora son tuyos", "New · from now on they are yours"), "k-create", "+"),
        (ChangeKind.Regenerate, L("Regenerados · gestionados por Stratum (*.g.cs, stratum.json)", "Regenerated · managed by Stratum (*.g.cs, stratum.json)"), "k-regen", "~"),
        (ChangeKind.Merge, L("Completados · solo se añade lo que falta", "Completed · only what's missing is added"), "k-merge", "±"),
        (ChangeKind.Replace, L("Reemplazados · archivos tuyos de la entidad que conviertes al formato editable", "Replaced · your files of the entity you convert to the editable format"), "k-del", "!"),
        (ChangeKind.Delete, L("Eliminados", "Deleted"), "k-del", "−"),
    ];

    private string? selectedPath;

    private FileChange? selected =>
        State.Plan?.Changes.FirstOrDefault(c => c.Path == selectedPath)
        ?? State.Plan?.Changes.FirstOrDefault(c => c.Kind != ChangeKind.Create)
        ?? State.Plan?.Changes.FirstOrDefault();

    protected override void OnInitialized()
    {
        State.Initialize();
        State.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;

    private void Apply()
    {
        selectedPath = null;
        State.ApplyPlan();
    }

    private static int Count(IReadOnlyList<FileChange> changes, ChangeKind kind) => changes.Count(c => c.Kind == kind);

    private static string LineCss(DiffKind kind) => kind switch
    {
        DiffKind.Added => "d-add",
        DiffKind.Removed => "d-del",
        _ => "d-same",
    };

    private static string Prefix(DiffKind kind) => kind switch
    {
        DiffKind.Added => "+ ",
        DiffKind.Removed => "- ",
        _ => "  ",
    };

}
