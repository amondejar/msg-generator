@page "/"
@implements IDisposable
@inject StudioState State
@inject NavigationManager Nav
@inject ProcessRunner Runner

<PageTitle>@L("Resumen", "Overview") · Stratum Studio</PageTitle>

<main class="content">
    <div>
        <h1>@L("Resumen del sistema", "System overview")</h1>
        <p class="lead">@L(@<text>Cada servicio se describe en su <span class="mono">stratum.json</span> y Stratum genera el código. Desde aquí lo diseñas, ves cómo se comunican y lo ejecutas.</text>, @<text>Each service is described in its <span class="mono">stratum.json</span> and Stratum generates the code. From here you design it, see how services talk to each other and run them.</text>)</p>
    </div>

    @if (State.LastMessage is { } message)
    {
        <div class="msg ok" role="status">@message</div>
    }

    @{
        var services = State.Services;
        var routes = State.EventRoutes();
        var entities = services.Sum(s => s.Definition.Entities.Count);
        var listening = services.Sum(s => s.Definition.Subscriptions?.Count ?? 0);
        var running = Runner.IsRunning(ServiceCommands.DashboardJob);
        var problems = routes.Count(r => r.Problem is not null);
    }

    <section class="kpis" aria-label="@L("Cifras del sistema", "System figures")">
        <a class="kpi" href="services"><b>@services.Count</b><span>@L("servicio(s)", "service(s)")</span></a>
        <div class="kpi"><b>@entities</b><span>@L("entidad(es)", "entity(ies)")</span></div>
        <a class="kpi" href="events"><b>@routes.Count</b><span>@L($"evento(s) · {listening} suscripción(es)", $"event(s) · {listening} subscription(s)")</span></a>
        <a class="kpi" href="run"><b style="color: @(running ? "var(--ok)" : "var(--muted)")">@(running ? L("En marcha", "Running") : L("Parado", "Stopped"))</b><span>@L("sistema con Aspire", "system with Aspire")</span></a>
        @if (problems > 0)
        {
            <a class="kpi" href="events" style="border-color: #5C4410"><b style="color: var(--warn)">@problems</b><span>@L("aviso(s) en el mapa de eventos", "warning(s) in the event map")</span></a>
        }
    </section>

    @if (problems > 0)
    {
        <section class="card stack" style="border-color: #5C4410; gap: 6px" aria-labelledby="h-warnings">
            <h2 class="section" id="h-warnings" style="margin: 0; color: var(--warn)">@L("Avisos del mapa de eventos", "Event map warnings")</h2>
            @foreach (var route in routes.Where(r => r.Problem is not null))
            {
                <span><span class="mono">@route.EventClass</span> <small class="hint mono">@route.Topic</small> · @route.Problem</span>
            }
            <a href="events" style="font-weight: 600; text-decoration: none">@L("Resolverlos en el mapa de eventos →", "Solve them in the event map →")</a>
        </section>
    }

    <section class="stack" aria-labelledby="h-start">
        <h2 class="section" id="h-start">@L("Qué quieres hacer", "What do you want to do")</h2>
        <div class="actions">
            <a class="action" href="services"><Icon Name="plus" Size="20" /><span><b>@L("Crear un servicio", "Create a service")</b><small>@L("Vertical slice o Clean + DDD, en esta carpeta o en otra.", "Vertical slice or Clean + DDD, in this folder or another one.")</small></span></a>
            <a class="action" href="events"><Icon Name="events" Size="20" /><span><b>@L("Conectar servicios", "Connect services")</b><small>@L("Quién publica cada evento y quién lo escucha.", "Who publishes each event and who listens to it.")</small></span></a>
            <a class="action" href="run"><Icon Name="run" Size="20" /><span><b>@L("Ejecutar el sistema", "Run the system")</b><small>@L("Aspire con bases de datos, Kafka y dashboard.", "Aspire with databases, Kafka and dashboard.")</small></span></a>
            <a class="action" href="templates"><Icon Name="templates" Size="20" /><span><b>@L("Convenciones del equipo", "Team conventions")</b><small>@L("Plantillas y tokens propios para todos los servicios.", "Your own templates and tokens for every service.")</small></span></a>
        </div>
    </section>

    <section class="stack" aria-labelledby="h-list">
        <div class="row" style="justify-content: space-between">
            <h2 class="section" id="h-list">@L("Servicios", "Services")</h2>
            <a href="services" style="font-weight: 600; text-decoration: none">@L("Gestionar →", "Manage →")</a>
        </div>
        @if (services.Count == 0)
        {
            <div class="card stack">
                <b>@L("El sistema está vacío.", "The system is empty.")</b>
                <span class="hint">@L(@<text>Crea el primer servicio en <a href="services">Servicios</a>.</text>, @<text>Create the first service in <a href="services">Services</a>.</text>)</span>
            </div>
        }
        else
        {
            <div class="table">
                <div class="tr head" style="grid-template-columns: 1.4fr 1.2fr 1fr .8fr 1.4fr"><span>@L("Servicio", "Service")</span><span>@L("Arquitectura", "Architecture")</span><span>@L("Base de datos", "Database")</span><span>@L("Entidades", "Entities")</span><span>@L("Mensajería", "Messaging")</span></div>
                @foreach (var service in services)
                {
                    var d = service.Definition;
                    var publishes = d.Entities.Count(e => e.Publishes);
                    <div class="tr" style="grid-template-columns: 1.4fr 1.2fr 1fr .8fr 1.4fr; cursor: pointer" @onclick="() => Open(service)" role="button" tabindex="0">
                        <span><b>@d.Service.Name</b>@if (State.IsExternal(service)) { <br /><small class="hint mono">@State.FullPath(service.Directory)</small> }</span>
                        <span>@(d.Architecture == Architectures.CleanDdd ? "Clean + DDD" : "Vertical slice")</span>
                        <span class="hint">@(d.Persistence?.Provider ?? "—")</span>
                        <span>@d.Entities.Count</span>
                        <span class="hint">
                            @if (d.Messaging is null)
                            {
                                <span>—</span>
                            }
                            else
                            {
                                <span>@d.Messaging.Broker · @L($"publica {publishes} · escucha {d.Subscriptions?.Count ?? 0}", $"publishes {publishes} · listens {d.Subscriptions?.Count ?? 0}")</span>
                            }
                        </span>
                    </div>
                }
            </div>
        }
    </section>
</main>

@code {
    protected override void OnInitialized()
    {
        State.Initialize();
        State.Changed += OnChanged;
        Runner.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Runner.Changed -= OnChanged;
    }

    private void Open(WorkspaceService service)
    {
        State.LastMessage = null;
        State.Open(service);
        Nav.NavigateTo("service");
    }
}
