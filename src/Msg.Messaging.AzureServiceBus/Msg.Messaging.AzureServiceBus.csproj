<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Msg.Messaging.AzureServiceBus</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Azure Service Bus broker for Msg.Messaging: one topic per integration event, one subscription per service, completes after handling, native dead-letter queue. Works with Aspire's Service Bus resource and its local emulator (connection string "servicebus").</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Msg.Messaging.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Msg.Messaging\Msg.Messaging.csproj" />
  </ItemGroup>

</Project>
