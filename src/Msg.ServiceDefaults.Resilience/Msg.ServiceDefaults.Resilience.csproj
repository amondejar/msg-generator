<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Msg.ServiceDefaults</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>MSG service defaults: standard resilience pipeline (retry, timeout, circuit breaker) for every HttpClient.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- IHostApplicationBuilder and friends; MSG services are ASP.NET Core apps anyway. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

</Project>
