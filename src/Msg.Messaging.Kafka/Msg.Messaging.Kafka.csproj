<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Msg.Messaging.Kafka</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Kafka broker for Msg.Messaging (Confluent.Kafka): one topic per integration event, one consumer group per service, manual commits after handling, dead-letter topic, topics created on demand. Works with Aspire's Kafka resource (connection string "kafka").</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Confluent.Kafka" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Msg.Messaging.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Msg.Messaging\Msg.Messaging.csproj" />
  </ItemGroup>

</Project>
