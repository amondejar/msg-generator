<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Stratum Studio</title>
    <style>
        :root {
            --bg: #0B0E13; --bar: #0F1319; --panel: #131821; --panel-2: #1A202C; --line: #222936; --line-2: #333C4D;
            --text: #E8ECF2; --text-2: #C8CFDA; --muted: #9AA4B5; --accent: #2DD4BF; --accent-ink: #052E2B; --accent-bg: #0F2A2A;
            --link: #93C5FD; --ok: #34D399; --warn: #FBBF24; --err: #F87171;
            --mono: ui-monospace, "Cascadia Code", "JetBrains Mono", Consolas, monospace;
            --radius: 10px;
        }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.5 Inter, "Segoe UI", system-ui, sans-serif; }
        a { color: var(--link); } a:hover { color: #BFDBFE; }
        code, pre, .mono { font-family: var(--mono); }
        h1 { margin: 0 0 6px; font-size: 24px; letter-spacing: -0.02em; }
        h2.section { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
        p.lead { margin: 0; color: var(--muted); max-width: 860px; }
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

        /* Shell: sidebar menu + main column (top bar + page). */
        .app { display: grid; grid-template-columns: 252px minmax(0, 1fr); min-height: 100vh; }
        .sidebar { position: sticky; top: 0; height: 100vh; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; padding: 16px 12px; background: var(--bar); border-right: 1px solid var(--line); }
        .brand { display: flex; align-items: center; gap: 10px; padding: 4px 10px 14px; color: var(--text); text-decoration: none; }
        .brand b { font-size: 16px; letter-spacing: -0.01em; }
        .brand small { color: var(--muted); font-weight: 500; }
        .ws { display: flex; align-items: center; gap: 8px; margin: 0 6px 10px; padding: 8px 10px; border-radius: 8px; background: var(--panel); border: 1px solid var(--line); font-size: 12px; color: var(--text-2); overflow: hidden; }
        .ws span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .nav-group { margin: 16px 12px 6px; font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); display: flex; justify-content: space-between; align-items: center; }
        .sidebar a.nav { display: flex; align-items: center; gap: 10px; min-height: 38px; padding: 0 12px; border-radius: 8px; color: var(--text-2); text-decoration: none; }
        .sidebar a.nav:hover { background: var(--panel); color: var(--text); }
        .sidebar a.nav.active { background: var(--accent-bg); color: var(--text); font-weight: 600; box-shadow: inset 3px 0 0 var(--accent); }
        .sidebar a.nav svg { flex: 0 0 auto; opacity: .85; }
        .sidebar a.nav .badge { margin-left: auto; }
        .badge { font-size: 11px; font-weight: 600; min-width: 22px; padding: 1px 7px; border-radius: 999px; background: var(--panel-2); color: var(--muted); text-align: center; }
        .badge.warn { background: #3A2A08; color: var(--warn); }
        .badge.live { background: #0D3326; color: var(--ok); }
        .switcher { margin: 0 6px 4px; }
        .switcher select { width: 100%; min-height: 38px; }
        .sidebar-foot { margin-top: auto; padding: 14px 12px 0; font-size: 12px; color: var(--muted); display: flex; flex-direction: column; gap: 4px; }

        .main { min-width: 0; display: flex; flex-direction: column; }
        .topbar { position: sticky; top: 0; z-index: 10; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; min-height: 58px; padding: 10px 28px; background: rgba(11, 14, 19, .88); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
        .crumbs { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 13px; }
        .crumbs b { color: var(--text); }
        .spacer { flex: 1 1 auto; }
        .pending { color: var(--warn); font-size: 13px; }
        .pill { font-size: 12px; color: var(--muted); padding: 3px 9px; border-radius: 999px; border: 1px solid var(--line-2); }
        .chip { display: inline-flex; gap: 8px; align-items: center; padding: 5px 12px; border: 1px solid var(--line-2); border-radius: 8px; background: var(--panel); }
        .page { display: flex; flex-wrap: wrap; flex: 1 1 auto; align-items: stretch; }
        .content { flex: 999 1 560px; min-width: 0; padding: 28px 32px 48px; display: flex; flex-direction: column; gap: 28px; }
        .preview { flex: 1 1 420px; max-width: 600px; min-width: 0; border-left: 1px solid var(--line); background: var(--bar); display: flex; flex-direction: column; }
        @@media (max-width: 960px) {
            .app { grid-template-columns: 1fr; }
            .sidebar { position: static; height: auto; }
            .content { padding: 20px 16px 40px; }
        }

        /* Overview */
        .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
        .kpi { padding: 14px 16px; border-radius: var(--radius); background: var(--panel); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 2px; text-decoration: none; color: var(--text); }
        a.kpi:hover { border-color: var(--line-2); }
        .kpi b { font-size: 26px; letter-spacing: -0.02em; }
        .kpi span { font-size: 12px; color: var(--muted); }
        .actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
        .action { display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; border-radius: var(--radius); border: 1px solid var(--line); background: linear-gradient(180deg, var(--panel), var(--bar)); color: var(--text); text-decoration: none; }
        .action:hover { border-color: var(--accent); }
        .action svg { margin-top: 2px; color: var(--accent); }
        .action small { display: block; color: var(--muted); }
        .layer-tag { font-size: 11px; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--line-2); color: var(--text-2); }

        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
        .card { padding: 14px 16px; border-radius: 10px; background: var(--panel); border: 1px solid var(--line); color: var(--text); text-align: left; font: inherit; }
        button.card, a.card { cursor: pointer; text-decoration: none; display: flex; flex-direction: column; gap: 6px; }
        .card.selected { border-color: var(--accent); background: var(--accent-bg); }
        .card.new { border-color: var(--warn); }
        .card small, .hint { font-size: 12px; color: var(--muted); }
        .stack { display: flex; flex-direction: column; gap: 12px; }
        .row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

        .btn { min-height: 40px; padding: 0 16px; border-radius: 8px; border: 1px solid var(--line-2); background: transparent; color: var(--text); font: inherit; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }
        .btn:hover { border-color: var(--muted); }
        .btn-primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
        .btn-primary:hover { filter: brightness(1.08); }
        .btn-dashed { border-style: dashed; color: var(--text-2); }
        .btn:disabled { opacity: .45; cursor: not-allowed; }
        .icon-btn { width: 40px; height: 40px; border: 0; border-radius: 6px; background: transparent; color: var(--muted); cursor: pointer; font-size: 18px; }
        .icon-btn:hover { color: var(--err); background: #2A1C22; }

        .feature { display: flex; gap: 14px; align-items: flex-start; }
        .switch { flex: 0 0 auto; position: relative; width: 44px; height: 26px; margin-top: 1px; border-radius: 999px; border: 0; padding: 0; background: var(--line-2); cursor: pointer; }
        .switch::after { content: ""; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 999px; background: #F4F5F8; transition: left .12s; }
        .switch[aria-pressed="true"] { background: var(--accent); }
        .switch[aria-pressed="true"]::after { left: 21px; }
        .switch:disabled { opacity: .5; cursor: not-allowed; }

        .seg { display: inline-flex; padding: 4px; gap: 4px; border-radius: 10px; background: var(--panel); border: 1px solid var(--line); align-self: flex-start; }
        .seg button { min-height: 38px; padding: 0 16px; border-radius: 7px; border: 0; background: transparent; color: var(--muted); font: inherit; cursor: pointer; }
        .seg button[aria-pressed="true"] { background: var(--accent-bg); color: var(--text); font-weight: 600; }
        .seg button:disabled { cursor: not-allowed; }

        label.field, div.field { display: flex; flex-direction: column; gap: 6px; font-size: 12px; font-weight: 600; color: var(--muted); flex: 1 1 200px; }
        div.field { flex: none; }
        .stack > label.field { flex: none; }   /* in a column, flex-basis would become a 200px height */
        div.field input { font-weight: 400; }
        .feature small.mono { overflow-wrap: anywhere; }
        .form-grid { display: grid; grid-template-columns: minmax(200px, 1fr) minmax(280px, 2fr); gap: 16px; align-items: start; }
        @@media (max-width: 760px) { .form-grid { grid-template-columns: 1fr; } }
        input[type=text], select { min-height: 42px; padding: 0 12px; border-radius: 8px; border: 1px solid var(--line-2); background: var(--panel); color: var(--text); font: inherit; font-size: 14px; }
        input[type=text]:focus, select:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
        input[type=checkbox] { width: 18px; height: 18px; accent-color: var(--accent); }

        .table { border: 1px solid var(--line); border-radius: 10px; background: var(--panel); overflow-x: auto; }
        .tr { display: grid; grid-template-columns: 2fr 1.3fr 1fr 2fr 48px; gap: 12px; align-items: center; min-width: 620px; padding: 8px 16px; border-bottom: 1px solid var(--line); }
        .tr:last-child { border-bottom: 0; }
        .tr.head { font-size: 12px; font-weight: 600; color: var(--muted); }
        .tr .auto { color: var(--muted); font-family: var(--mono); }
        .tr input[type=text], .tr select { min-height: 38px; background: #11131A; font-family: var(--mono); font-size: 13px; }

        .tabs { display: flex; flex-wrap: wrap; gap: 4px; padding: 10px 12px; border-bottom: 1px solid var(--line); }
        .tabs button { min-height: 34px; padding: 0 10px; border-radius: 6px; border: 0; background: transparent; color: var(--muted); font: inherit; font-size: 13px; cursor: pointer; }
        .tabs button[aria-pressed="true"] { background: var(--panel-2); color: var(--text); font-weight: 600; }
        pre.code { margin: 0; padding: 16px 20px; overflow: auto; font-size: 12.5px; line-height: 1.65; color: #D5D9E2; white-space: pre; flex: 1 1 auto; max-height: 72vh; }
        .tok-c { color: #7D8799; } .tok-s { color: #FCD34D; } .tok-k { color: #93C5FD; } .tok-t { color: #5EEAD4; }
        .d-add { background: #10301F; color: #A7F3D0; display: block; } .d-del { background: #3A1A1F; color: #FECACA; display: block; } .d-same { display: block; }

        .files { border: 1px solid var(--line); border-radius: 10px; background: var(--panel); overflow: hidden; }
        .files button { width: 100%; display: flex; gap: 12px; align-items: center; min-height: 38px; padding: 0 16px; border: 0; border-bottom: 1px solid #1F2330; background: transparent; color: #D5D9E2; font: 12.5px var(--mono); text-align: left; cursor: pointer; }
        .files button:last-child { border-bottom: 0; }
        .files button.sel { background: var(--panel-2); }
        .k-create { color: var(--ok); font-weight: 700; } .k-regen { color: var(--warn); font-weight: 700; } .k-merge { color: #67E8F9; font-weight: 700; } .k-del { color: var(--err); font-weight: 700; }
        .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
        .stats .card b { font-size: 28px; display: block; }

        .msg { padding: 12px 14px; border-radius: 10px; border: 1px solid; }
        .msg.err { border-color: #7F1D1D; background: #2A1416; color: #FECACA; }
        .msg.ok { border-color: #065F46; background: #0E241C; color: #A7F3D0; }
        .msg.warn { border-color: #78350F; background: #261C0B; color: #FDE68A; white-space: pre-wrap; }
        .msg ul { margin: 0; padding-left: 18px; }
    </style>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
