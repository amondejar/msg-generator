@page "/apply"
@implements IDisposable
@inject StudioState State

<PageTitle>Aplicar cambios · msg studio</PageTitle>

@if (State.Current is not { } draft)
{
    <main class="content"><p class="lead">No hay ningún servicio abierto. <a href="/">Elige uno en Sistema</a>.</p></main>
}
else
{
    var plan = State.Plan;
    var changes = plan?.Changes ?? [];
    <main class="content">
        <div class="row" style="justify-content: space-between; align-items: flex-end">
            <div>
                <h1>Aplicar cambios</h1>
                <p class="lead">
                    @(draft.IsNew ? $"Servicio nuevo {draft.Name} en la carpeta {draft.Directory}." : $"Cambios en {draft.Name}.")
                    Revisa qué va a escribir MSG en tu repositorio.
                </p>
            </div>
            <div class="stack" style="gap: 4px; align-items: flex-end">
                <button type="button" class="btn btn-primary" style="min-height: 44px" disabled="@(plan is null || changes.Count == 0)" @onclick="Apply">
                    Aplicar al repositorio
                </button>
                @if (plan is null)
                {
                    <span class="hint" style="color: var(--err)">Corrige los problemas de abajo para poder aplicar.</span>
                }
                else if (changes.Count == 0)
                {
                    <span class="hint">Nada que aplicar: todo está escrito.</span>
                }
            </div>
        </div>

        @if (State.LastMessage is { } message)
        {
            <div class="msg ok" role="status">
                @message
                <div class="row" style="margin-top: 10px">
                    @if (draft.Entities.Count > 0)
                    {
                        <a class="btn" href="service#migrations">Crear la migración →</a>
                    }
                    <a class="btn" href="/">Ejecutar el sistema →</a>
                    <span class="mono hint">o: dotnet test @(draft.Directory)</span>
                </div>
            </div>
        }

        <ProblemList />

        @if (plan is not null)
        {
            <div class="stats">
                <div class="card"><b style="color: var(--ok)">@Count(changes, ChangeKind.Create)</b>archivos nuevos</div>
                <div class="card"><b style="color: var(--warn)">@Count(changes, ChangeKind.Regenerate)</b>regenerados por MSG</div>
                <div class="card"><b style="color: #67E8F9">@Count(changes, ChangeKind.Merge)</b>completados (solo se añade)</div>
                <div class="card"><b style="@(changes.Any(c => c.TouchesUserCode) ? "color: var(--err)" : "")">@changes.Count(c => c.TouchesUserCode)</b>archivos tuyos reemplazados o borrados</div>
            </div>

            @if (changes.Count == 0)
            {
                <p class="lead">No hay cambios pendientes. Añade una entidad en el <a href="entities">diseñador</a>.</p>
            }

            @foreach (var (kind, title, css, symbol) in Groups)
            {
                var group = changes.Where(c => c.Kind == kind).ToList();
                if (group.Count == 0) { continue; }
                <section class="stack" style="gap: 8px">
                    <h2 class="section">@title</h2>
                    <div class="files">
                        @foreach (var change in group)
                        {
                            <button type="button" class="@(change.Path == selected?.Path ? "sel" : "")" @onclick="() => selectedPath = change.Path">
                                <span class="@css">@symbol</span> @change.Path @if (change.TouchesUserCode) { <small style="color: var(--err)">· tuyo</small> }
                            </button>
                        }
                    </div>
                </section>
            }

            @foreach (var warning in plan.Warnings)
            {
                <div class="msg warn" role="note">⚠ @warning</div>
            }
        }
    </main>

    <aside class="preview" aria-label="Diferencias">
        @if (selected is { } current)
        {
            <div class="hint mono" style="padding: 12px 20px; border-bottom: 1px solid var(--line)">@current.Path</div>
            <pre class="code">@foreach (var line in CodeView.Diff(current.Previous, current.Content))
{<span class="@LineCss(line.Kind)">@(Prefix(line.Kind))@line.Text</span>}</pre>
        }
        else
        {
            <p class="hint" style="padding: 16px 20px">Selecciona un archivo para ver qué cambia.</p>
        }
    </aside>
}

@code {
    private static readonly (ChangeKind Kind, string Title, string Css, string Symbol)[] Groups =
    [
        (ChangeKind.Create, "Nuevos · a partir de ahora son tuyos", "k-create", "+"),
        (ChangeKind.Regenerate, "Regenerados · gestionados por MSG (*.g.cs, msg.json)", "k-regen", "~"),
        (ChangeKind.Merge, "Completados · solo se añade lo que falta", "k-merge", "±"),
        (ChangeKind.Replace, "Reemplazados · archivos tuyos de la entidad que conviertes al formato editable", "k-del", "!"),
        (ChangeKind.Delete, "Eliminados", "k-del", "−"),
    ];

    private string? selectedPath;

    private FileChange? selected =>
        State.Plan?.Changes.FirstOrDefault(c => c.Path == selectedPath)
        ?? State.Plan?.Changes.FirstOrDefault(c => c.Kind != ChangeKind.Create)
        ?? State.Plan?.Changes.FirstOrDefault();

    protected override void OnInitialized()
    {
        State.Initialize();
        State.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;

    private void Apply()
    {
        selectedPath = null;
        State.ApplyPlan();
    }

    private static int Count(IReadOnlyList<FileChange> changes, ChangeKind kind) => changes.Count(c => c.Kind == kind);

    private static string LineCss(DiffKind kind) => kind switch
    {
        DiffKind.Added => "d-add",
        DiffKind.Removed => "d-del",
        _ => "d-same",
    };

    private static string Prefix(DiffKind kind) => kind switch
    {
        DiffKind.Added => "+ ",
        DiffKind.Removed => "- ",
        _ => "  ",
    };

}
