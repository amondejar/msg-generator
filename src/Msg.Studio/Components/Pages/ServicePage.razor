@page "/service"
@implements IDisposable
@inject StudioState State
@inject NavigationManager Nav

<PageTitle>Servicio · msg studio</PageTitle>

@if (State.Current is not { } draft)
{
    <main class="content"><p class="lead">No hay ningún servicio abierto. <a href="/">Elige uno en Sistema</a>.</p></main>
}
else
{
    <main class="content">
        <div>
            <h1>@(draft.IsNew ? "Nuevo servicio" : "Servicio")</h1>
            <p class="lead">
                Lo que eliges aquí se guarda en <code>msg.json</code>. La vista previa muestra el código que se va a generar.
                @if (!draft.CanEditStructure)
                {
                    <span>En un servicio que ya existe puedes activar o desactivar features y <a href="entities">cambiar las entidades</a>; la arquitectura y la base de datos quedan fijas.</span>
                }
            </p>
        </div>

        @if (draft.IsNew)
        {
            <label class="field" style="max-width: 360px">
                Nombre del servicio
                <input type="text" value="@draft.Name" @onchange="e => { draft.Name = e.Value?.ToString() ?? string.Empty; State.Recompute(); }" />
            </label>
        }

        <section class="stack" aria-labelledby="h-arch">
            <h2 class="section" id="h-arch">Arquitectura</h2>
            <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr))">
                <button type="button" class="card @(draft.Architecture == Architectures.VerticalSlice ? "selected" : "")"
                        aria-pressed="@(draft.Architecture == Architectures.VerticalSlice ? "true" : "false")"
                        disabled="@(!draft.CanEditStructure)" @onclick="() => SetArchitecture(Architectures.VerticalSlice)">
                    <b>Vertical slice</b>
                    <small>Un proyecto, organizado por features. Los endpoints usan EF Core directamente. Ideal para servicios de CRUD.</small>
                    <small class="mono">src/@(draft.Name).Api/Features/…</small>
                </button>
                <button type="button" class="card @(draft.Architecture == Architectures.CleanDdd ? "selected" : "")"
                        aria-pressed="@(draft.Architecture == Architectures.CleanDdd ? "true" : "false")"
                        disabled="@(!draft.CanEditStructure)" @onclick="() => SetArchitecture(Architectures.CleanDdd)">
                    <b>Clean + DDD</b>
                    <small>Agregados con comportamiento, eventos de dominio y casos de uso. Dependencias hacia el dominio.</small>
                    <small class="mono">Domain · Application · Infrastructure · Api</small>
                </button>
            </div>
        </section>

        <section class="stack" aria-labelledby="h-features">
            <h2 class="section" id="h-features">Features</h2>
            @if (!draft.CanEditFeatures)
            {
                <div class="msg warn" role="status">
                    <b>Program.cs es de una versión de MSG anterior a la 0.12</b> y configura las features a mano, así que MSG no puede cambiarlas sin pisarlo.
                    Al pasarlo a <span class="mono">MsgWiring.g.cs</span>, Program.cs queda en unas pocas líneas (<span class="mono">builder.AddMsgWiring()</span>, <span class="mono">app.UseMsgWiring()</span>) y las features se activan y desactivan desde aquí.
                    Si habías añadido código propio en Program.cs, el diff te enseña tu versión para volver a ponerlo.
                    <div class="row" style="margin-top: 10px">
                        <button type="button" class="btn btn-primary" @onclick="() => { draft.ConvertWiring = true; State.Recompute(); }">Pasar Program.cs a MsgWiring</button>
                    </div>
                </div>
            }
            else if (!draft.IsNew)
            {
                <span class="hint">Al desactivar una feature, MSG quita sus paquetes y borra sus archivos solo si siguen como él los generó; si los cambiaste, te avisa en lugar de borrarlos.</span>
            }
            <div class="grid">
                @foreach (var (key, name, description, package) in FeatureList)
                {
                    var on = draft.Features.IsEnabled(key);
                    <div class="card feature">
                        <button type="button" class="switch" aria-pressed="@(on ? "true" : "false")" aria-label="@((on ? "Desactivar " : "Activar ") + name)"
                                disabled="@(!draft.CanEditFeatures)" @onclick="() => Toggle(key, !on)"></button>
                        <div class="stack" style="gap: 4px; min-width: 0">
                            <b>@name</b>
                            <small>@description</small>
                            <small class="mono">@package</small>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="stack" aria-labelledby="h-db">
            <h2 class="section" id="h-db">Base de datos</h2>
            <div class="seg" role="group" aria-label="Proveedor de base de datos">
                <button type="button" aria-pressed="@(draft.Provider == PersistenceSettings.Postgres ? "true" : "false")" disabled="@draft.ProviderLocked" @onclick="() => SetProvider(PersistenceSettings.Postgres)">PostgreSQL</button>
                <button type="button" aria-pressed="@(draft.Provider == PersistenceSettings.SqlServer ? "true" : "false")" disabled="@draft.ProviderLocked" @onclick="() => SetProvider(PersistenceSettings.SqlServer)">SQL Server</button>
            </div>
            <span class="hint">@(draft.ProviderLocked ? "Fijada: el servicio ya tiene entidades en esta base de datos." : "Se fija con la primera entidad. Los tests usan SQLite en memoria, así que no necesitan Docker.")</span>
        </section>

        <section class="stack" aria-labelledby="h-messaging">
            <h2 class="section" id="h-messaging">Mensajería entre servicios</h2>
            <div class="seg" role="group" aria-label="Broker de mensajería">
                <button type="button" aria-pressed="@(draft.Broker is null ? "true" : "false")" disabled="@(!draft.CanEditFeatures)" @onclick="() => SetBroker(null)">Sin mensajería</button>
                <button type="button" aria-pressed="@(draft.Broker == MessagingSettings.Kafka ? "true" : "false")" disabled="@(!draft.CanEditFeatures)" @onclick="() => SetBroker(MessagingSettings.Kafka)">Kafka</button>
                <button type="button" aria-pressed="@(draft.Broker == MessagingSettings.InMemory ? "true" : "false")" disabled="@(!draft.CanEditFeatures)" @onclick="() => SetBroker(MessagingSettings.InMemory)">En memoria</button>
            </div>
            <span class="hint">
                @if (draft.Broker == MessagingSettings.Kafka)
                {
                    <span>Eventos de integración con outbox (no se pierden si Kafka cae), inbox (cada evento se procesa una vez), reintentos y dead-letter. Con Aspire, MSG añade Kafka y Kafka UI al AppHost. Elige qué entidades publican sus eventos en <a href="entities">Entidades</a>.</span>
                }
                else if (draft.Broker == MessagingSettings.InMemory)
                {
                    <span>Los eventos no salen de este proceso: útil para empezar o para un servicio solo. Cambia a Kafka para que lleguen a otros servicios; tus handlers no cambian.</span>
                }
                else
                {
                    <span>Actívala para que este servicio publique eventos (OrderCreated…) o reaccione a los de otros.</span>
                }
                @if (draft.Broker is not null && draft.ProviderLocked && !draft.IsNew)
                {
                    <span> Después de aplicar, crea una migración: añade las tablas <span class="mono">msg_outbox</span> y <span class="mono">msg_inbox</span>.</span>
                }
            </span>
        </section>

        @if (draft.Broker is not null)
        {
            var available = State.AvailableEvents(draft).Where(e => !draft.Subscriptions.Any(e.Matches)).ToList();
            var problems = State.SubscriptionProblems(draft);
            <section class="stack" aria-labelledby="h-subscriptions">
                <h2 class="section" id="h-subscriptions">Eventos que escucha</h2>
                @if (draft.Subscriptions.Count == 0)
                {
                    <span class="hint">Todavía no reacciona a eventos de otros servicios.</span>
                }
                else
                {
                    <div class="table">
                        @foreach (var subscription in draft.Subscriptions.ToList())
                        {
                            var problem = problems.FirstOrDefault(p => p.Subscription == subscription);
                            <div class="tr" style="grid-template-columns: 2.2fr 1.6fr auto; align-items: center">
                                <span>
                                    <span class="mono">@subscription.Topic</span>
                                    @if (problem.Problem is { } text)
                                    {
                                        <br /><small style="color: var(--warn)">⚠ @text</small>
                                    }
                                </span>
                                <span class="hint mono">@(subscription.EventClass)Handler @(draft.Architecture == Architectures.CleanDdd ? "· Application" : "· Api")/Events/@subscription.Service</span>
                                <span class="row" style="gap: 6px">
                                    @if (problem.Current is { } latest)
                                    {
                                        <button type="button" class="btn" @onclick="() => ReplaceSubscription(subscription, latest)">Actualizar contrato</button>
                                    }
                                    <button type="button" class="btn" style="color: var(--err)" @onclick="() => RemoveSubscription(subscription)">Quitar</button>
                                </span>
                            </div>
                        }
                    </div>
                }
                @if (available.Count > 0)
                {
                    <div class="row" style="gap: 8px; align-items: flex-end">
                        <label class="field" style="flex: 0 1 380px">
                            Escuchar un evento de otro servicio
                            <select @bind="selectedTopic">
                                <option value="">Elige un evento…</option>
                                @foreach (var group in available.GroupBy(e => e.Service))
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var e in group)
                                        {
                                            <option value="@e.Topic">@e.EventClass (@e.Topic)</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </label>
                        <button type="button" class="btn btn-primary" disabled="@string.IsNullOrEmpty(selectedTopic)" @onclick="() => AddSubscription(available)">+ Escuchar</button>
                    </div>
                    <span class="hint">MSG copia el contrato del evento y crea un handler vacío para tu lógica (tuyo: no lo vuelve a tocar). Cada evento se procesa una vez, con reintentos y dead-letter.</span>
                }
                else if (draft.Subscriptions.Count == 0)
                {
                    <span class="hint">Ningún otro servicio del sistema publica eventos. Actívalo en sus <em>Entidades → Eventos para otros servicios</em>.</span>
                }
                @if (draft.Broker == MessagingSettings.InMemory && draft.Subscriptions.Count > 0)
                {
                    <span class="hint" style="color: var(--warn)">Con el broker en memoria no llegan eventos de otros servicios: usa Kafka.</span>
                }
            </section>
        }

        <section class="stack" aria-labelledby="h-entities">
            <div class="row" style="justify-content: space-between">
                <h2 class="section" id="h-entities">Entidades</h2>
                <a href="entities" style="font-weight: 600; text-decoration: none">Abrir diseñador →</a>
            </div>
            <div class="grid">
                @foreach (var entity in draft.Entities)
                {
                    <button type="button" class="card @(entity.IsNew ? "new" : "")" @onclick="() => OpenEntity(entity)">
                        <b>@entity.Name @if (entity.IsNew) { <small style="color: var(--warn); margin-left: 6px">NUEVA</small> }</b>
                        <small class="mono">/api/v1/@ServiceName.ToKebab(SafePlural(entity)) · @entity.Properties.Count propiedad(es)</small>
                    </button>
                }
                <button type="button" class="btn btn-dashed" style="min-height: 76px" @onclick="NewEntity">+ Nueva entidad</button>
            </div>
        </section>

        @if (!draft.IsNew && draft.ProviderLocked)
        {
            <MigrationsPanel ServiceDirectory="@Path.Combine(State.Workspace, draft.Directory)" />
        }

        <ProblemList />
    </main>

    <CodePanel Tabs="Tabs" />
}

@code {
    private static readonly (string Key, string Name, string Description, string Package)[] FeatureList =
    [
        ("observability", "Observabilidad", "Trazas, métricas y logs con OpenTelemetry. Aspire las muestra en su dashboard.", "Msg.ServiceDefaults.OpenTelemetry"),
        ("openApi", "OpenAPI + Scalar", "Documento /openapi/v1.json y Scalar en /scalar para explorar y probar la API.", "Microsoft.AspNetCore.OpenApi · Scalar.AspNetCore"),
        ("resilience", "Clientes HTTP", "Reintentos, timeout, circuit breaker y service discovery en todos los HttpClient.", "Msg.ServiceDefaults.Resilience"),
        ("auth", "Autenticación", "JWT bearer. Todo autenticado por defecto salvo los health checks.", "Msg.ServiceDefaults.Authentication"),
        ("tests", "Tests", "Tests de integración del contrato común y de cada entidad.", "xUnit · WebApplicationFactory"),
        ("docker", "Docker", "Dockerfile multi-stage con usuario no-root.", "Dockerfile"),
        ("ci", "CI", "GitHub Actions: build, test y auditoría de paquetes.", ".github/workflows/ci.yml"),
    ];

    private IReadOnlyList<CodePanel.Tab> Tabs
    {
        get
        {
            var files = State.Preview;
            var program = files.FirstOrDefault(f => f.Path.EndsWith("Api/Program.cs", StringComparison.Ordinal));
            var json = files.FirstOrDefault(f => f.Path == ServiceGenerator.DefinitionFileName);
            var tree = string.Join("\n", files.Select(f => f.Path).Order(StringComparer.Ordinal));

            var tabs = new List<CodePanel.Tab>();
            if (program is not null) { tabs.Add(new("Program.cs", program.Path, program.Content)); }
            tabs.Add(new($"Archivos ({files.Count})", "(árbol de archivos)", tree));
            if (json is not null) { tabs.Add(new("msg.json", json.Path, json.Content)); }
            return tabs;
        }
    }

    protected override void OnInitialized()
    {
        State.Initialize();
        State.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;

    private void SetArchitecture(string architecture)
    {
        State.Current!.Architecture = architecture;
        State.Recompute();
    }

    private void Toggle(string feature, bool enabled)
    {
        State.Current!.Features = State.Current.Features.With(feature, enabled);
        State.Recompute();
    }

    private string selectedTopic = string.Empty;

    private void AddSubscription(IReadOnlyList<Subscription> available)
    {
        if (available.FirstOrDefault(e => e.Topic == selectedTopic) is { } subscription)
        {
            State.Current!.Subscriptions.Add(subscription);
            selectedTopic = string.Empty;
            State.Recompute();
        }
    }

    private void RemoveSubscription(Subscription subscription)
    {
        State.Current!.Subscriptions.Remove(subscription);
        State.Recompute();
    }

    private void ReplaceSubscription(Subscription old, Subscription latest)
    {
        var list = State.Current!.Subscriptions;
        list[list.IndexOf(old)] = latest;
        State.Recompute();
    }

    private void SetBroker(string? broker)
    {
        State.Current!.Broker = broker;
        if (broker is null)
        {
            foreach (var entity in State.Current.Entities)
            {
                entity.PublishEvents = false;
            }

            State.Current.Subscriptions.Clear();
        }

        State.Recompute();
    }

    private void SetProvider(string provider)
    {
        State.Current!.Provider = provider;
        State.Recompute();
    }

    private void OpenEntity(EntityDraft entity)
    {
        State.SelectedEntity = entity.Name;
        Nav.NavigateTo("entities");
    }

    private void NewEntity()
    {
        State.AddEntity();
        Nav.NavigateTo("entities");
    }

    private static string SafePlural(EntityDraft entity)
    {
        try { return ServiceName.Normalize(entity.EffectivePlural); }
        catch (MsgException) { return entity.EffectivePlural; }
    }
}
