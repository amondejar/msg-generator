@page "/service"
@implements IDisposable
@inject StudioState State
@inject NavigationManager Nav

<PageTitle>General · Stratum Studio</PageTitle>

@if (State.Current is not { } draft)
{
    <main class="content"><p class="lead">No hay ningún servicio abierto. Elige uno en <a href="services">Servicios</a>.</p></main>
}
else
{
    <main class="content">
        <div>
            <h1>@(draft.IsNew ? "Nuevo servicio" : draft.Name)</h1>
            <p class="lead">
                @if (draft.IsNew)
                {
                    <span>Elige el nombre, la arquitectura y las features. Nada se crea hasta que pulses <a href="apply">Revisar y aplicar</a>.</span>
                }
                else
                {
                    <span>Arquitectura y features del servicio. Puedes activar o desactivar features cuando quieras: Stratum regenera lo suyo y no pisa tu código. La arquitectura queda fija.</span>
                }
            </p>
        </div>

        @if (draft.IsNew)
        {
            <label class="field" style="max-width: 360px">
                Nombre del servicio
                <input type="text" value="@draft.Name" @onchange="e => { draft.Name = e.Value?.ToString() ?? string.Empty; State.Recompute(); }" />
            </label>
        }

        <section class="stack" aria-labelledby="h-arch">
            <h2 class="section" id="h-arch">Arquitectura</h2>
            <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr))">
                <button type="button" class="card @(draft.Architecture == Architectures.VerticalSlice ? "selected" : "")"
                        aria-pressed="@(draft.Architecture == Architectures.VerticalSlice ? "true" : "false")"
                        disabled="@(!draft.CanEditStructure)" @onclick="() => SetArchitecture(Architectures.VerticalSlice)">
                    <b>Vertical slice</b>
                    <small>Un proyecto, organizado por features. Los endpoints usan EF Core directamente. Ideal para servicios de CRUD.</small>
                    <small class="mono">src/@(draft.Name).Api/Features/…</small>
                </button>
                <button type="button" class="card @(draft.Architecture == Architectures.CleanDdd ? "selected" : "")"
                        aria-pressed="@(draft.Architecture == Architectures.CleanDdd ? "true" : "false")"
                        disabled="@(!draft.CanEditStructure)" @onclick="() => SetArchitecture(Architectures.CleanDdd)">
                    <b>Clean + DDD</b>
                    <small>Agregados con comportamiento, eventos de dominio y casos de uso. Dependencias hacia el dominio.</small>
                    <small class="mono">Domain · Application · Infrastructure · Api</small>
                </button>
            </div>
        </section>

        <section class="stack" aria-labelledby="h-features">
            <h2 class="section" id="h-features">Features</h2>
            @if (!draft.CanEditFeatures)
            {
                <div class="msg warn" role="status">
                    <b>Program.cs es de una versión de Stratum anterior a la 0.12</b> y configura las features a mano, así que Stratum no puede cambiarlas sin pisarlo.
                    Al pasarlo a <span class="mono">MsgWiring.g.cs</span>, Program.cs queda en unas pocas líneas (<span class="mono">builder.AddMsgWiring()</span>, <span class="mono">app.UseMsgWiring()</span>) y las features se activan y desactivan desde aquí.
                    Si habías añadido código propio en Program.cs, el diff te enseña tu versión para volver a ponerlo.
                    <div class="row" style="margin-top: 10px">
                        <button type="button" class="btn btn-primary" @onclick="() => { draft.ConvertWiring = true; State.Recompute(); }">Pasar Program.cs a MsgWiring</button>
                    </div>
                </div>
            }
            else if (!draft.IsNew)
            {
                <span class="hint">Al desactivar una feature, Stratum quita sus paquetes y borra sus archivos solo si siguen como él los generó; si los cambiaste, te avisa en lugar de borrarlos.</span>
            }
            <div class="grid">
                @foreach (var (key, name, description, package) in FeatureList)
                {
                    var on = draft.Features.IsEnabled(key);
                    <div class="card feature">
                        <button type="button" class="switch" aria-pressed="@(on ? "true" : "false")" aria-label="@((on ? "Desactivar " : "Activar ") + name)"
                                disabled="@(!draft.CanEditFeatures)" @onclick="() => Toggle(key, !on)"></button>
                        <div class="stack" style="gap: 4px; min-width: 0">
                            <b>@name</b>
                            <small>@description</small>
                            <small class="mono">@package</small>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="stack" aria-labelledby="h-next">
            <h2 class="section" id="h-next">Del servicio</h2>
            <div class="actions">
                <a class="action" href="entities"><Icon Name="entities" Size="20" /><span><b>Entidades · @draft.Entities.Count</b><small>Propiedades, CRUD, reglas y eventos que publica.</small></span></a>
                <a class="action" href="service/data"><Icon Name="data" Size="20" /><span><b>Datos y migraciones</b><small>@(draft.Entities.Count == 0 ? "La base de datos se fija con la primera entidad." : $"{draft.Provider} · migraciones guiadas")</small></span></a>
                <a class="action" href="service/messaging"><Icon Name="messaging" Size="20" /><span><b>Mensajería</b><small>@(draft.Broker is null ? "Desactivada" : $"{draft.Broker} · escucha {draft.Subscriptions.Count} evento(s)")</small></span></a>
                <a class="action" href="service/code"><Icon Name="code" Size="20" /><span><b>Código generado</b><small>Program.cs, árbol de archivos y msg.json.</small></span></a>
            </div>
        </section>

        <ProblemList />

        @if (!draft.IsNew)
        {
            <section class="stack" aria-labelledby="h-danger">
                <h2 class="section" id="h-danger" style="color: var(--err)">Zona peligrosa</h2>
                <div class="card row" style="justify-content: space-between; border-color: #5B1A1A">
                    <span>
                        <b>Eliminar el servicio</b><br />
                        <small class="hint">Su carpeta, las suscripciones de otros servicios a sus eventos y su sitio en el AppHost. Verás todo antes de confirmar.</small>
                    </span>
                    <a class="btn" style="color: var(--err); border-color: #7F1D1D" href="service/remove">Eliminar @draft.Name…</a>
                </div>
            </section>
        }
    </main>
}

@code {
    private static readonly (string Key, string Name, string Description, string Package)[] FeatureList =
    [
        ("observability", "Observabilidad", "Trazas, métricas y logs con OpenTelemetry. Aspire las muestra en su dashboard.", "Msg.ServiceDefaults.OpenTelemetry"),
        ("openApi", "OpenAPI + Scalar", "Documento /openapi/v1.json y Scalar en /scalar para explorar y probar la API.", "Microsoft.AspNetCore.OpenApi · Scalar.AspNetCore"),
        ("resilience", "Clientes HTTP", "Reintentos, timeout, circuit breaker y service discovery en todos los HttpClient.", "Msg.ServiceDefaults.Resilience"),
        ("auth", "Autenticación", "JWT bearer. Todo autenticado por defecto salvo los health checks.", "Msg.ServiceDefaults.Authentication"),
        ("tests", "Tests", "Tests de integración del contrato común y de cada entidad.", "xUnit · WebApplicationFactory"),
        ("docker", "Docker", "Dockerfile multi-stage con usuario no-root.", "Dockerfile"),
        ("ci", "CI", "GitHub Actions: build, test y auditoría de paquetes.", ".github/workflows/ci.yml"),
    ];

    protected override void OnInitialized()
    {
        State.Initialize();
        State.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;

    private void SetArchitecture(string architecture)
    {
        State.Current!.Architecture = architecture;
        State.Recompute();
    }

    private void Toggle(string feature, bool enabled)
    {
        State.Current!.Features = State.Current.Features.With(feature, enabled);
        State.Recompute();
    }

}
