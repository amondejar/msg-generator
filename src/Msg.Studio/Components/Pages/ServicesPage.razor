@page "/services"
@implements IDisposable
@inject StudioState State
@inject NavigationManager Nav

<PageTitle>Servicios · Stratum Studio</PageTitle>

<main class="content">
    <div>
        <h1>Servicios</h1>
        <p class="lead">Los servicios del sistema <span class="mono">@State.Workspace</span>, incluidos los de otras carpetas (<span class="mono">msg.workspace.json</span>). Abre uno para configurarlo o crea uno nuevo donde quieras.</p>
    </div>
    @if (State.LastMessage is { } message)
    {
        <div class="msg ok" role="status">@message</div>
    }
    <section class="stack" aria-labelledby="h-services">
        <h2 class="section" id="h-services">En el sistema · @State.Services.Count</h2>
        @if (State.Services.Count == 0)
        {
            <span class="hint">Todavía no hay servicios.</span>
        }
        <div class="grid" style="align-items: start">
            @foreach (var service in State.Services)
            {
                var d = service.Definition;
                <button type="button" class="card" @onclick="() => Open(service)">
                    <span class="row" style="justify-content: space-between; gap: 8px">
                        <b style="font-size: 15px">@d.Service.Name</b>
                        <span class="layer-tag">@(d.Architecture == Architectures.CleanDdd ? "Clean + DDD" : "Vertical slice")</span>
                    </span>
                    <small class="mono" title="@State.FullPath(service.Directory)">@(State.IsExternal(service) ? State.FullPath(service.Directory) : service.Directory)</small>
                    <small>
                        @(d.Persistence?.Provider ?? "sin base de datos") · @d.Entities.Count entidad(es)@(d.Messaging is null ? "" : $" · {d.Messaging.Broker}")
                    </small>
                    @if (State.IsExternal(service))
                    {
                        <small class="hint">Fuera de la carpeta del sistema</small>
                    }
                </button>
            }
        </div>
    </section>

    <section class="stack" aria-labelledby="h-new">
        <h2 class="section" id="h-new">Crear un servicio</h2>
        <div class="card stack" style="gap: 14px">
            <div class="form-grid">
                <label class="field">
                    Nombre
                    <input type="text" placeholder="Orders" @bind="newName" @bind:event="oninput" @onkeydown="OnKey" aria-describedby="new-hint" />
                </label>
                <div class="field">
                    Ubicación
                    <FolderPicker @bind-Value="newLocation" Label="Carpeta donde crear el servicio" />
                </div>
            </div>
            <div class="row" style="justify-content: space-between">
                <span class="hint" id="new-hint">
                    Se creará en <span class="mono">@NewFolder</span>@if (!WorkspaceFile.IsInside(State.Workspace, newLocation)) {<span> · fuera de la carpeta del sistema: Stratum lo apunta en <span class="mono">msg.workspace.json</span>.</span>}
                </span>
                <button type="button" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(newName)" @onclick="Create"><Icon Name="plus" Size="16" /> Crear y configurar</button>
            </div>
        </div>
        @if (error is not null)
        {
            <div class="msg err" role="alert">@error</div>
        }
    </section>

    <section class="stack" aria-labelledby="h-external">
        <h2 class="section" id="h-external">Añadir un servicio de otra carpeta</h2>
        <div class="card stack" style="gap: 14px">
            <div class="field">
                Carpeta del servicio (la que tiene msg.json)
                <FolderPicker @bind-Value="externalPath" Label="Carpeta del servicio" />
            </div>
            <div class="row" style="justify-content: space-between">
                <span class="hint">Otro disco u otro repositorio. No se mueve ni se copia: se apunta en <span class="mono">msg.workspace.json</span>.</span>
                <button type="button" class="btn" disabled="@string.IsNullOrWhiteSpace(externalPath)" @onclick="AddExternal">Añadir al sistema</button>
            </div>
        </div>
    </section>
</main>

@code {
    private string newName = string.Empty;
    private string newLocation = string.Empty;
    private string externalPath = string.Empty;
    private string? error;

    private string NewFolder
    {
        get
        {
            try { return Path.Combine(newLocation, string.IsNullOrWhiteSpace(newName) ? "…" : ServiceName.ToKebab(ServiceName.Normalize(newName))); }
            catch (MsgException) { return "…"; }
        }
    }

    protected override void OnInitialized()
    {
        State.Initialize();
        newLocation = State.Workspace;
        externalPath = Path.GetDirectoryName(State.Workspace) ?? State.Workspace;
        State.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;

    private void Open(WorkspaceService service)
    {
        State.LastMessage = null;
        State.Open(service);
        Nav.NavigateTo("service");
    }

    private void Create()
    {
        try
        {
            error = null;
            State.LastMessage = null;
            State.StartNewService(newName, newLocation);
            Nav.NavigateTo("service");
        }
        catch (MsgException ex)
        {
            error = ex.Message;
        }
    }

    private void AddExternal()
    {
        try
        {
            error = null;
            State.AddExternalService(externalPath);
            State.LastMessage = $"✔ Servicio de {externalPath} añadido al sistema.";
        }
        catch (MsgException ex)
        {
            error = ex.Message;
        }
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newName))
        {
            Create();
        }
    }
}
