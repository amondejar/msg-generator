@* Right-hand panel: tabs over a set of generated files, with syntax highlighting. *@

<aside class="preview" aria-label="@Label" style="@(Wide ? "max-width: none; border-left: 0; flex: 1 1 100%" : null)">
    <div class="tabs" role="toolbar" aria-label="Archivos">
        @foreach (var tab in Tabs)
        {
            <button type="button" aria-pressed="@(tab.Path == Selected?.Path ? "true" : "false")" title="@tab.Path" @onclick="() => selectedPath = tab.Path">@tab.Title</button>
        }
    </div>
    @if (Selected is { } file)
    {
        <div class="hint mono" style="padding: 8px 20px 0">@file.Path</div>
        <pre class="code">@((MarkupString)CodeView.Highlight(file.Content))</pre>
    }
    else
    {
        <p class="hint" style="padding: 16px 20px">@Empty</p>
    }
    @ChildContent
</aside>

@code {
    public sealed record Tab(string Title, string Path, string Content);

    [Parameter, EditorRequired] public IReadOnlyList<Tab> Tabs { get; set; } = [];

    [Parameter] public string Label { get; set; } = "Vista previa";

    [Parameter] public string Empty { get; set; } = "Nada que mostrar todavía.";

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Fills the page (Código generado) instead of being a side panel.</summary>
    [Parameter] public bool Wide { get; set; }

    private string? selectedPath;

    private Tab? Selected => Tabs.FirstOrDefault(t => t.Path == selectedPath) ?? Tabs.FirstOrDefault();
}
