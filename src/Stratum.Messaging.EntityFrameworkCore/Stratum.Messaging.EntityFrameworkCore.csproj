<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Stratum.Messaging.EntityFrameworkCore</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Transactional outbox and inbox for Stratum.Messaging with EF Core: integration events are saved in the same transaction as your changes, and each received event is handled once.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stratum.Messaging\Stratum.Messaging.csproj" />
    <ProjectReference Include="..\Stratum.Ddd\Stratum.Ddd.csproj" />
  </ItemGroup>

</Project>
