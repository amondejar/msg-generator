<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Msg.Core</RootNamespace>
  </PropertyGroup>

  <!--
    Las plantillas viven en /templates (fuera del proyecto, para que no se compilen)
    y se incrustan como recursos. Así la CLI y el futuro editor visual usan exactamente
    las mismas plantillas sin depender de rutas en disco.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\templates\**\*"
                      LogicalName="templates/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
