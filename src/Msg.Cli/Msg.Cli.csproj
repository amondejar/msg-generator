<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Msg.Cli</RootNamespace>
    <AssemblyName>msg</AssemblyName>

    <!-- Installable as a global .NET tool (see README). -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>msg</ToolCommandName>
    <PackageId>Msg.Cli</PackageId>

    <!--
      msg studio hosts Blazor components that live in Msg.Studio. Since .NET 10, blazor.web.js comes from the
      implicit package Microsoft.AspNetCore.App.Internal.Assets, which the SDK only adds to projects that
      contain .razor files. This host has none, so it must ask for it explicitly (otherwise: 404, no interactivity).
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <PackageOutputPath>../../artifacts</PackageOutputPath>
    <Description>MSG: generador de microservicios .NET con las convenciones de tu equipo.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Msg.Core\Msg.Core.csproj" />
    <ProjectReference Include="..\Msg.Studio\Msg.Studio.csproj" />
  </ItemGroup>

</Project>
