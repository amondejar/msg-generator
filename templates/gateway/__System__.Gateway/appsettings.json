{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    // Origins of a frontend served from elsewhere (another port or domain), e.g. [ "http://localhost:5173" ].
    // Not needed when the gateway serves it (wwwroot) or proxies its dev server (Frontend:Url).
    "Cors": {
      "Origins": []
    },
    // The frontend's dev server (Vite, Angular...), e.g. "http://localhost:5173": everything that isn't /api,
    // /services, /bff or /health goes there, so the frontend and the API share the origin. Empty: wwwroot is served.
    "Frontend": {
      "Url": ""
    }
    // @stratum:if bff
    ,
    // The frontend's session (BFF): the gateway signs the user in with your identity provider (OpenID Connect),
    // keeps the tokens in its cookie and sends the access token to the services. Without Authority the gateway
    // works, but /bff/login answers 503.
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      // Scopes besides "openid profile offline_access": the one of your API, e.g. "api://orders/.default" or "orders".
      "Scopes": ""
    }
    // @stratum:end
  }
}
