<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-cutting concerns shared by the service: health checks, error handling,
    correlation id, options validation, telemetry, resilience, auth.
    The Api project calls AddServiceDefaults() / UseServiceDefaults() / MapDefaultEndpoints().
  -->

  <PropertyGroup>
    <RootNamespace>{{Service}}.ServiceDefaults</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- @msg:if observability -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <!-- @msg:end -->
    <!-- @msg:if resilience -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- @msg:end -->
    <!-- @msg:if auth -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- @msg:end -->
  </ItemGroup>

</Project>
