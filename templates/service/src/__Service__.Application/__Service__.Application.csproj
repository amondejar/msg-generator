<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Use cases: commands, queries and domain event handlers. Depends only on the Domain.
    Infrastructure implements the contracts declared here (IUnitOfWork) and in the Domain (repositories).
  -->

  <PropertyGroup>
    <RootNamespace>{{Service}}.Application</RootNamespace>
  </PropertyGroup>

  <!-- @stratum:if messaging -->
  <ItemGroup>
    <PackageReference Include="StratumKit.Messaging" />
  </ItemGroup>

  <!-- @stratum:end -->
  <ItemGroup>
    <ProjectReference Include="..\{{Service}}.Domain\{{Service}}.Domain.csproj" />
  </ItemGroup>

  <!-- @stratum:if hasModelTypes -->
  <ItemGroup>
    <!-- Enums and item types of stratum.json, usable everywhere without a using. -->
    <Using Include="{{EnumNamespace}}" />
  </ItemGroup>
  <!-- @stratum:end -->

</Project>
