<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>{{Service}}.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Msg.ServiceDefaults" />
    <!-- @msg:if observability -->
    <PackageReference Include="Msg.ServiceDefaults.OpenTelemetry" />
    <!-- @msg:end -->
    <!-- @msg:if resilience -->
    <PackageReference Include="Msg.ServiceDefaults.Resilience" />
    <!-- @msg:end -->
    <!-- @msg:if auth -->
    <PackageReference Include="Msg.ServiceDefaults.Authentication" />
    <!-- @msg:end -->
    <!-- @msg:if openApi -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- @msg:end -->
    <!-- @msg:if postgres -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- @msg:end -->
    <!-- @msg:if sqlserver -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- @msg:end -->
    <!-- @msg:if persistence -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- @msg:end -->
  </ItemGroup>

</Project>
