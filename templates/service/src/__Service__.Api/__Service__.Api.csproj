<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>{{Service}}.Api</RootNamespace>
    <!-- The <summary> comments of endpoints and DTOs go into the OpenAPI document. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StratumKit.ServiceDefaults" />
    <!-- @stratum:if observability -->
    <PackageReference Include="StratumKit.ServiceDefaults.OpenTelemetry" />
    <!-- @stratum:end -->
    <!-- @stratum:if resilience -->
    <PackageReference Include="StratumKit.ServiceDefaults.Resilience" />
    <!-- @stratum:end -->
    <!-- @stratum:if auth -->
    <PackageReference Include="StratumKit.ServiceDefaults.Authentication" />
    <!-- @stratum:end -->
    <!-- @stratum:if kafka -->
    <PackageReference Include="StratumKit.Messaging.Kafka" />
    <!-- @stratum:end -->
    <!-- @stratum:if azureServiceBus -->
    <PackageReference Include="StratumKit.Messaging.AzureServiceBus" />
    <!-- @stratum:end -->
    <!-- @stratum:if verticalSlice -->
    <!-- @stratum:if messaging -->
    <PackageReference Include="StratumKit.Messaging" />
    <!-- @stratum:if persistence -->
    <PackageReference Include="StratumKit.Messaging.EntityFrameworkCore" />
    <!-- @stratum:end -->
    <!-- @stratum:end -->
    <!-- @stratum:end -->
    <!-- @stratum:if mcp -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <!-- @stratum:end -->
    <!-- @stratum:if openApi -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- @stratum:end -->
    <!-- @stratum:if verticalSlice -->
    <!-- @stratum:if postgres -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- @stratum:end -->
    <!-- @stratum:if sqlserver -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- @stratum:end -->
    <!-- @stratum:if persistence -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <!-- @stratum:end -->
    <!-- @stratum:end -->
    <!-- @stratum:if persistence -->
    <!-- Startup project for "dotnet ef" migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- @stratum:end -->
  </ItemGroup>
  <!-- @stratum:if cleanDdd -->

  <ItemGroup>
    <ProjectReference Include="..\{{Service}}.Application\{{Service}}.Application.csproj" />
    <ProjectReference Include="..\{{Service}}.Infrastructure\{{Service}}.Infrastructure.csproj" />
  </ItemGroup>
  <!-- @stratum:end -->

  <!-- @stratum:if hasModelTypes -->
  <ItemGroup>
    <!-- Enums and item types of stratum.json, usable everywhere without a using. -->
    <Using Include="{{EnumNamespace}}" />
  </ItemGroup>
  <!-- @stratum:end -->

</Project>
