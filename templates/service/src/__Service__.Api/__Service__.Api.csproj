<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>{{Service}}.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stratum.ServiceDefaults" />
    <!-- @stratum:if observability -->
    <PackageReference Include="Stratum.ServiceDefaults.OpenTelemetry" />
    <!-- @stratum:end -->
    <!-- @stratum:if resilience -->
    <PackageReference Include="Stratum.ServiceDefaults.Resilience" />
    <!-- @stratum:end -->
    <!-- @stratum:if auth -->
    <PackageReference Include="Stratum.ServiceDefaults.Authentication" />
    <!-- @stratum:end -->
    <!-- @stratum:if kafka -->
    <PackageReference Include="Stratum.Messaging.Kafka" />
    <!-- @stratum:end -->
    <!-- @stratum:if azureServiceBus -->
    <PackageReference Include="Stratum.Messaging.AzureServiceBus" />
    <!-- @stratum:end -->
    <!-- @stratum:if verticalSlice -->
    <!-- @stratum:if messaging -->
    <PackageReference Include="Stratum.Messaging" />
    <!-- @stratum:if persistence -->
    <PackageReference Include="Stratum.Messaging.EntityFrameworkCore" />
    <!-- @stratum:end -->
    <!-- @stratum:end -->
    <!-- @stratum:end -->
    <!-- @stratum:if mcp -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <!-- @stratum:end -->
    <!-- @stratum:if openApi -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- @stratum:end -->
    <!-- @stratum:if verticalSlice -->
    <!-- @stratum:if postgres -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- @stratum:end -->
    <!-- @stratum:if sqlserver -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- @stratum:end -->
    <!-- @stratum:if persistence -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <!-- @stratum:end -->
    <!-- @stratum:end -->
    <!-- @stratum:if persistence -->
    <!-- Startup project for "dotnet ef" migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- @stratum:end -->
  </ItemGroup>
  <!-- @stratum:if cleanDdd -->

  <ItemGroup>
    <ProjectReference Include="..\{{Service}}.Application\{{Service}}.Application.csproj" />
    <ProjectReference Include="..\{{Service}}.Infrastructure\{{Service}}.Infrastructure.csproj" />
  </ItemGroup>
  <!-- @stratum:end -->

</Project>
